+From 47ed5785e494ffc3a8b71b12ab54a842d8d696b6 Mon Sep 17 00:00:00 2001
+From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
+Date: Wed, 18 Feb 2026 09:56:32 +0100
+Subject: [PATCH] video/filter/refqueue: add mp_refqueue_output_fields
+
+---
+ video/filter/refqueue.c | 7 ++++++-
+ video/filter/refqueue.h | 1 +
+ 2 files changed, 7 insertions(+), 1 deletion(-)
+
+diff --git a/video/filter/refqueue.c b/video/filter/refqueue.c
+index 078981c65cdb0..0b6ade2d13787 100644
+--- a/video/filter/refqueue.c
++++ b/video/filter/refqueue.c
+@@ -176,7 +176,7 @@ static bool output_next_field(struct mp_refqueue *q)
+ {
+     if (q->second_field)
+         return false;
+-    if (!(q->flags & MP_MODE_OUTPUT_FIELDS))
++    if (!mp_refqueue_output_fields(q))
+         return false;
+     if (!mp_refqueue_should_deint(q))
+         return false;
+@@ -368,3 +368,8 @@ struct mp_image *mp_refqueue_get_format(struct mp_refqueue *q)
+ {
+     return q->in_format;
+ }
++
++bool mp_refqueue_output_fields(struct mp_refqueue *q)
++{
++    return q->flags & MP_MODE_OUTPUT_FIELDS;
++}
+diff --git a/video/filter/refqueue.h b/video/filter/refqueue.h
+index d14058d609570..179c66f618edf 100644
+--- a/video/filter/refqueue.h
++++ b/video/filter/refqueue.h
+@@ -36,6 +36,7 @@ enum {
+ void mp_refqueue_set_mode(struct mp_refqueue *q, int flags);
+ void mp_refqueue_set_parity(struct mp_refqueue *q, int parity);
+ bool mp_refqueue_should_deint(struct mp_refqueue *q);
++bool mp_refqueue_output_fields(struct mp_refqueue *q);
+ bool mp_refqueue_is_top_field(struct mp_refqueue *q);
+ bool mp_refqueue_top_field_first(struct mp_refqueue *q);
+ bool mp_refqueue_is_second_field(struct mp_refqueue *q);

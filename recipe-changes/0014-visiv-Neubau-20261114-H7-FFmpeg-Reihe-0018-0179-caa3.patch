@@ -0,0 +1,32 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: "visiv (nnexd GmbH)" <support@visiv.tv>
+Date: Sat, 14 Nov 2026 00:00:00 +0000
+Subject: [PATCH 157/179] avcodec/exif: pass the byte bound in
+ avpriv_exif_decode_ifd()
+
+Second half of the adjustment of avpriv_exif_decode_ifd() for the
+backported EXIF bounds: 30fff47764 also bounds the value bytes of an IFD
+tree, so pass the same initial value as in av_exif_parse_buffer() (bytes
+limited by the buffer size).
+
+visiv addition for the backport series (not in FFmpeg); second half of the
+former single patch, placed right after 30fff47764.
+---
+ libavcodec/exif.c | 3 ++-
+ 1 file changed, 2 insertions(+), 1 deletion(-)
+
+diff --git a/libavcodec/exif.c b/libavcodec/exif.c
+index d829cfdb38..7af7ec86aa 100644
+--- a/libavcodec/exif.c
++++ b/libavcodec/exif.c
+@@ -1089,8 +1089,9 @@ int avpriv_exif_decode_ifd(void *logctx, const uint8_t *buf, int size,
+     GetByteContext gb;
+     int ret;
+     int entries_left[2] = { size / BASE_TAG_SIZE, size / BASE_TAG_SIZE };
++    size_t bytes_left[2] = { size, size };
+     bytestream2_init(&gb, buf, size);
+-    ret = exif_parse_ifd_list(logctx, &gb, le, depth, entries_left, &ifd, 0);
++    ret = exif_parse_ifd_list(logctx, &gb, le, depth, entries_left, bytes_left, &ifd, 0);
+     if (ret < 0)
+         return ret;
+     ret = av_exif_ifd_to_dict(logctx, &ifd, metadata);

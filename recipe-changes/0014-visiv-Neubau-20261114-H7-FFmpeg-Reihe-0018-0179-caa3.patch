+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: "visiv (nnexd GmbH)" <support@visiv.tv>
+Date: Sat, 14 Nov 2026 00:00:00 +0000
+Subject: [PATCH 097/179] avcodec/exif: pass the entry bound in
+ avpriv_exif_decode_ifd()
+
+release/8.1 still has avpriv_exif_decode_ifd() (removed in master by
+e930e2e60a), so the bound of the parsed IFD entries backported from
+26bf8651a8 has to be passed there too, with the same initial value as in
+av_exif_parse_buffer() (entries limited by the buffer size). No caller in
+libavcodec/libavformat uses the function; it only has to compile.
+
+visiv addition for the backport series (not in FFmpeg); first half of the
+former single patch, placed right after 26bf8651a8 so that every step of
+the series compiles.
+---
+ libavcodec/exif.c | 3 ++-
+ 1 file changed, 2 insertions(+), 1 deletion(-)
+
+diff --git a/libavcodec/exif.c b/libavcodec/exif.c
+index 01fbcb0f45..b6ecfdff0f 100644
+--- a/libavcodec/exif.c
++++ b/libavcodec/exif.c
+@@ -1082,8 +1082,9 @@ int avpriv_exif_decode_ifd(void *logctx, const uint8_t *buf, int size,
+     AVExifMetadata ifd = { 0 };
+     GetByteContext gb;
+     int ret;
++    int entries_left[2] = { size / BASE_TAG_SIZE, size / BASE_TAG_SIZE };
+     bytestream2_init(&gb, buf, size);
+-    ret = exif_parse_ifd_list(logctx, &gb, le, depth, &ifd, 0);
++    ret = exif_parse_ifd_list(logctx, &gb, le, depth, entries_left, &ifd, 0);
+     if (ret < 0)
+         return ret;
+     ret = av_exif_ifd_to_dict(logctx, &ifd, metadata);

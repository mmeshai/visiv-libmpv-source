+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Michael Niedermayer <michael@niedermayer.cc>
+Date: Mon, 12 Oct 2026 02:48:35 +0200
+Subject: [PATCH 178/178] avutil/hwcontext_cuda: copy only the bytes of the
+ visible rows
+
+Fixes: out of array access
+Fixes: ZqshmgSdN2Q2
+Found during triage of the review of https://code.ffmpeg.org/FFmpeg/FFmpeg/pulls/24595
+Out of array read and write Replicated through API with ASAN
+Out of array read Replicated through UnModified FFmpeg with a guard page allocator
+
+[visiv: backported to release/8.1 by hand - 8.1 has the older cuda_transfer_data()
+ (no CUarray path, no fail label; the exit label always returns 0). Only the fix
+ itself is taken over: WidthInBytes is the byte width of the visible row from
+ av_image_get_linesize() instead of FFMIN(src/dst linesize); on an invalid width
+ the context is popped and the error is returned. Nothing else changed.]
+(cherry picked from commit f07f02abb864de022b973220e46ef24d203d8bbd)
+---
+ libavutil/hwcontext_cuda.c | 8 +++++++-
+ 1 file changed, 7 insertions(+), 1 deletion(-)
+
+diff --git a/libavutil/hwcontext_cuda.c b/libavutil/hwcontext_cuda.c
+index 46f8297168..832180e504 100644
+--- a/libavutil/hwcontext_cuda.c
++++ b/libavutil/hwcontext_cuda.c
+@@ -255,10 +255,16 @@ static int cuda_transfer_data(AVHWFramesContext *ctx, AVFrame *dst,
+         return ret;
+ 
+     for (i = 0; i < FF_ARRAY_ELEMS(src->data) && src->data[i]; i++) {
++        int bytewidth = av_image_get_linesize(ctx->sw_format, src->width, i);
++        if (bytewidth < 0) {
++            CHECK_CU(cu->cuCtxPopCurrent(&dummy));
++            return bytewidth;
++        }
++
+         CUDA_MEMCPY2D cpy = {
+             .srcPitch      = src->linesize[i],
+             .dstPitch      = dst->linesize[i],
+-            .WidthInBytes  = FFMIN(src->linesize[i], dst->linesize[i]),
++            .WidthInBytes  = bytewidth,
+             .Height        = src->height >> ((i == 0 || i == 3) ? 0 : priv->shift_height),
+         };
+ 

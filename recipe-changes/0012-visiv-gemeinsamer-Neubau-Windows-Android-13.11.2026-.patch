++
++static inline void yuvPlanartouyvy_line_mmxext(uint8_t *dst, const uint8_t *ysrc, const uint8_t *usrc, const uint8_t *vsrc,
++                                           x86_reg chromWidth)
++{
++    __asm__ volatile(
++        "xor             %%"FF_REG_a", %%"FF_REG_a" \n\t"

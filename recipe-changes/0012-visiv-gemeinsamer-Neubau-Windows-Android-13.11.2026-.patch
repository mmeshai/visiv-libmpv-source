diff --git a/packages/ffmpeg-0020-libavformat-mpegts.c-pat_cb-Ensure-all-PIDs-are-vali.patch b/packages/ffmpeg-0020-libavformat-mpegts.c-pat_cb-Ensure-all-PIDs-are-vali.patch
new file mode 100644
index 0000000..aca55ea
--- /dev/null
+++ b/packages/ffmpeg-0020-libavformat-mpegts.c-pat_cb-Ensure-all-PIDs-are-vali.patch
@@ -0,0 +1,41 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Scott Theisen <scott.the.elm@gmail.com>
+Date: Mon, 30 Jun 2025 00:21:45 -0400
+Subject: [PATCH 020/178] libavformat/mpegts.c: pat_cb(): Ensure all PIDs are
+ valid
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+but just ignore invalid PAT entries so subsequent valid
+entries are parsed.
+
+ISO/IEC 13818-1:2021 specifies a valid range of [0x0010, 0x1FFE] in
+§ 2.4.4.6 Semantic definition of fields in program association section
+and Table 2-3 – PID table
+
+ts->current_pid is always 0 since that is the PID for the PAT.
+
+(cherry picked from commit 7516bf24dba8b66e1463208dd21ba0f20293017a)
+---
+ libavformat/mpegts.c | 7 +++++--
+ 1 file changed, 5 insertions(+), 2 deletions(-)
+
+diff --git a/libavformat/mpegts.c b/libavformat/mpegts.c
+index 8ba6998b1d..4b82906907 100644
+--- a/libavformat/mpegts.c
++++ b/libavformat/mpegts.c
+@@ -2808,8 +2808,11 @@ static void pat_cb(MpegTSFilter *filter, const uint8_t *section, int section_len
+             break;
+         pmt_pid &= 0x1fff;
+ 
+-        if (pmt_pid == ts->current_pid)
+-            break;
++        if (pmt_pid <= 0x000F || pmt_pid == 0x1FFF) {
++            av_log(ts->stream, AV_LOG_WARNING,
++                   "Ignoring invalid PAT entry: sid=0x%x pid=0x%x\n", sid, pmt_pid);
++            continue;
++        }
+ 
+         av_log(ts->stream, AV_LOG_TRACE, "sid=0x%x pid=0x%x\n", sid, pmt_pid);
+ 

diff --git a/packages/ffmpeg-0142-avformat-id3v2-tighten-v2.4-non-synchsafe-frame-size.patch b/packages/ffmpeg-0142-avformat-id3v2-tighten-v2.4-non-synchsafe-frame-size.patch
new file mode 100644
index 0000000..62dc549
--- /dev/null
+++ b/packages/ffmpeg-0142-avformat-id3v2-tighten-v2.4-non-synchsafe-frame-size.patch
@@ -0,0 +1,125 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Jun Zhao <barryjzhao@tencent.com>
+Date: Sat, 24 Oct 2026 16:05:24 +0800
+Subject: [PATCH 142/178] avformat/id3v2: tighten v2.4 non-synchsafe frame size
+ boundary check
+
+A valid synchsafe integer has the MSB cleared in every byte, and a
+candidate next-frame boundary inside an ID3v2.4 tag must be followed by
+the end of the tag, zero padding, or a plausible 10-byte frame header
+whose size fits in the remaining tag bytes.
+
+Previously, size_to_syncsafe(tlen) was probed even when tlen had bit 7
+set in one of its bytes (such as 0x000000b6), and check_tag() accepted
+any four uppercase ASCII characters (such as "LLLL" inside a chapter
+title) as a valid next frame ID without checking the following frame
+size. It could also read past the end of the ID3v2 tag when the last
+frame had fewer than 4 bytes of padding.
+
+Check tlen with is_syncsafe() before probing size_to_syncsafe(tlen), bound
+the probe to the remaining tag bytes, and verify in check_tag() that a
+candidate frame header fits in the remaining tag length (including empty
+frames, which id3v2_parse() skips).
+
+Signed-off-by: Jun Zhao <barryjzhao@tencent.com>
+(cherry picked from commit 260d32d06d9b158ccbf31569421d074eafc5043c)
+---
+ libavformat/id3v2.c | 59 ++++++++++++++++++++++++++++++++++-----------
+ 1 file changed, 45 insertions(+), 14 deletions(-)
+
+diff --git a/libavformat/id3v2.c b/libavformat/id3v2.c
+index 5fc82ad9dc..c459740ebc 100644
+--- a/libavformat/id3v2.c
++++ b/libavformat/id3v2.c
+@@ -177,6 +177,14 @@ static unsigned int get_size(AVIOContext *s, int len)
+     return v;
+ }
+ 
++static int is_syncsafe(unsigned int size)
++{
++    return !(size & ((0x80U <<  0) |
++                     (0x80U <<  8) |
++                     (0x80U << 16) |
++                     (0x80U << 24)));
++}
++
+ static unsigned int size_to_syncsafe(unsigned int size)
+ {
+     return (((size) & (0x7f <<  0)) >> 0) +
+@@ -203,20 +211,38 @@ static int is_tag(const char *buf, unsigned int len)
+ }
+ 
+ /**
+- * Return 1 if the tag of length len at the given offset is valid, 0 if not, -1 on error
++ * Return 1 if the candidate frame boundary at offset (with rem bytes left in
++ * the ID3v2 tag after it) is followed by the end of the tag, zero padding, or
++ * a plausible 10-byte ID3v2.3/2.4 frame header; 0 if not, -1 on error.
+  */

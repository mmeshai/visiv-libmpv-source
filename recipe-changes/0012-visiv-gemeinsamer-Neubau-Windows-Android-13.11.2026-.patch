diff --git a/packages/mpv-0007-demux_mkv-pad-header-stripping-output-for-LZO.patch b/packages/mpv-0007-demux_mkv-pad-header-stripping-output-for-LZO.patch
new file mode 100644
index 0000000..6aad57b
--- /dev/null
+++ b/packages/mpv-0007-demux_mkv-pad-header-stripping-output-for-LZO.patch
@@ -0,0 +1,33 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: kasparovabi <104397842+kasparovabi@users.noreply.github.com>
+Date: Wed, 4 Nov 2026 15:16:40 +0000
+Subject: [PATCH 7/7] demux_mkv: pad header stripping output for LZO
+
+The result can be the input of a following LZO encoding, and
+av_lzo1x_decode() reads up to AV_LZO_INPUT_PADDING bytes past the end
+of its input.
+
+Fixes: GHSA-c5qc-xq95-9v7j
+(cherry picked from commit fb92603988496e7b579d8c9e10c94951aceef416)
+---
+ demux/demux_mkv.c | 4 +++-
+ 1 file changed, 3 insertions(+), 1 deletion(-)
+
+diff --git a/demux/demux_mkv.c b/demux/demux_mkv.c
+index 46a714230e..2ad93dcd36 100644
+--- a/demux/demux_mkv.c
++++ b/demux/demux_mkv.c
+@@ -414,10 +414,12 @@ static bstr demux_mkv_decode(struct mp_log *log, mkv_track_t *track,
+                 mp_warn(log, "missing comp_settings, unable to reconstruct the data.\n");
+                 goto error;
+             }
+-            dest = talloc_size(track->parser_tmp, size + enc->comp_settings_len);
++            dest = talloc_size(track->parser_tmp,
++                               size + enc->comp_settings_len + AV_LZO_INPUT_PADDING);
+             memcpy(dest, enc->comp_settings, enc->comp_settings_len);
+             memcpy(dest + enc->comp_settings_len, src, size);
+             size += enc->comp_settings_len;
++            memset(dest + size, 0, AV_LZO_INPUT_PADDING);
+         }
+     }
+ 

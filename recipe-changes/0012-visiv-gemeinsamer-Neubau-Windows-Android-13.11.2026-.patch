diff --git a/packages/ffmpeg-0069-avformat-mov-bound-ipco-and-ipma-by-the-iprp-size.patch b/packages/ffmpeg-0069-avformat-mov-bound-ipco-and-ipma-by-the-iprp-size.patch
new file mode 100644
index 0000000..8b3b76c
--- /dev/null
+++ b/packages/ffmpeg-0069-avformat-mov-bound-ipco-and-ipma-by-the-iprp-size.patch
@@ -0,0 +1,57 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Michael Niedermayer <michael@niedermayer.cc>
+Date: Sun, 4 Oct 2026 23:42:28 +0200
+Subject: [PATCH 069/178] avformat/mov: bound ipco and ipma by the iprp size
+
+This is hardening, no memory safety issue is known to depend on it.
+
+Found-by: OpenAI Security Research
+Reported in the security report srZp1wXh4CXQ
+
+Signed-off-by: Michael Niedermayer <michael@niedermayer.cc>
+(cherry picked from commit e3f5f17548bc7b773aefd420747863bc35741e37)
+---
+ libavformat/mov.c | 9 ++++++---
+ 1 file changed, 6 insertions(+), 3 deletions(-)
+
+diff --git a/libavformat/mov.c b/libavformat/mov.c
+index ad15a54fd6..e01ac6a3f2 100644
+--- a/libavformat/mov.c
++++ b/libavformat/mov.c
+@@ -9486,9 +9486,10 @@ static int mov_read_iprp(MOVContext *c, AVIOContext *pb, MOVAtom atom)
+     a.size = avio_rb32(pb);
+     a.type = avio_rl32(pb);
+ 
+-    if (a.size < 8 || a.type != MKTAG('i','p','c','o'))
++    if (a.size < 8 || a.size > atom.size || a.type != MKTAG('i','p','c','o'))
+         return AVERROR_INVALIDDATA;
+ 
++    atom.size -= a.size;
+     a.size -= 8;
+     while (a.size >= 8) {
+         MOVAtoms *ref = av_dynarray2_add((void**)&atoms, &nb_atoms, sizeof(MOVAtoms), NULL);
+@@ -9524,7 +9525,7 @@ static int mov_read_iprp(MOVContext *c, AVIOContext *pb, MOVAtom atom)
+     a.size = avio_rb32(pb);
+     a.type = avio_rl32(pb);
+ 
+-    if (a.size < 8 || a.type != MKTAG('i','p','m','a')) {
++    if (a.size < 16 || a.size > atom.size || a.type != MKTAG('i','p','m','a')) {
+         ret = AVERROR_INVALIDDATA;
+         goto fail;
+     }
+@@ -9532,12 +9533,14 @@ static int mov_read_iprp(MOVContext *c, AVIOContext *pb, MOVAtom atom)
+     version = avio_r8(pb);
+     flags   = avio_rb24(pb);
+     count   = avio_rb32(pb);
++    a.size -= 16;
+ 
+     for (int i = 0; i < count; i++) {
+         int item_id = version ? avio_rb32(pb) : avio_rb16(pb);
+         int assoc_count = avio_r8(pb);
+ 
+-        if (avio_feof(pb)) {
++        a.size -= (version ? 5 : 3) + assoc_count * (1 + (flags & 1));
++        if (avio_feof(pb) || a.size < 0) {
+             ret = AVERROR_INVALIDDATA;
+             goto fail;
+         }
diff --git a/packages/ffmpeg-0070-avformat-mov-do-not-seek-back-to-cache-ipco-properti.patch b/packages/ffmpeg-0070-avformat-mov-do-not-seek-back-to-cache-ipco-properti.patch
new file mode 100644
index 0000000..79359b4
--- /dev/null

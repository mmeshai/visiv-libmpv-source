diff --git a/packages/ffmpeg-0147-avformat-mov-reject-tfra-boxes-smaller-than-their-he.patch b/packages/ffmpeg-0147-avformat-mov-reject-tfra-boxes-smaller-than-their-he.patch
new file mode 100644
index 0000000..9a62fa5
--- /dev/null
+++ b/packages/ffmpeg-0147-avformat-mov-reject-tfra-boxes-smaller-than-their-he.patch
@@ -0,0 +1,40 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Martin Mirchev <mmirchev@comp.nus.edu.sg>
+Date: Tue, 27 Oct 2026 10:45:34 +0800
+Subject: [PATCH 147/178] avformat/mov: reject tfra boxes smaller than their
+ header
+
+mov_read_mfra() calls read_tfra() until it returns non-zero, and
+read_tfra() ends by seeking to the box start plus its declared size.
+A tfra box with size 0 therefore seeks back onto itself and is parsed
+again forever. Since the whole box stays in the AVIOContext buffer, no
+read reaches the protocol layer and the interrupt callback is never
+checked, so the demuxer cannot be interrupted either.
+
+The mfra is read on the first moof when use_mfra_for is enabled, which
+an "Anevia" free box does by default, so a 76-byte file can make
+avformat_open_input() spin indefinitely.
+
+Signed-off-by: Martin Mirchev <mmirchev@comp.nus.edu.sg>
+(cherry picked from commit 332df18e67c0f689d4dd5d0b2154e612cd871b3e)
+---
+ libavformat/mov.c | 6 ++++++
+ 1 file changed, 6 insertions(+)
+
+diff --git a/libavformat/mov.c b/libavformat/mov.c
+index a81dcb6725..9acf760f95 100644
+--- a/libavformat/mov.c
++++ b/libavformat/mov.c
+@@ -10316,6 +10316,12 @@ static int read_tfra(MOVContext *mov, AVIOContext *f)
+     if (avio_rb32(f) != MKBETAG('t', 'f', 'r', 'a')) {
+         return 1;
+     }
++    /* A tfra box can not be smaller than its 24-byte header. A size of 0
++     * would make mov_read_mfra() re-read the same box forever. */
++    if (size < 24) {
++        av_log(mov->fc, AV_LOG_ERROR, "Invalid tfra size %"PRIu32"\n", size);
++        return AVERROR_INVALIDDATA;
++    }
+     av_log(mov->fc, AV_LOG_VERBOSE, "found tfra\n");
+ 
+     version = avio_r8(f);
diff --git a/packages/ffmpeg-0148-avcodec-dvbsubdec-compute-the-clut-scores-incrementa.patch b/packages/ffmpeg-0148-avcodec-dvbsubdec-compute-the-clut-scores-incrementa.patch
new file mode 100644
index 0000000..4676acd
--- /dev/null
+++ b/packages/ffmpeg-0148-avcodec-dvbsubdec-compute-the-clut-scores-incrementa.patch
@@ -0,0 +1,62 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: romainhedouin <romain.hedouin@epitech.eu>
+Date: Mon, 2 Nov 2026 01:15:39 +0100
+Subject: [PATCH 148/178] avcodec/dvbsubdec: compute the clut scores
+ incrementally
+
+compute_default_clut() recomputed the score of every candidate from
+scratch, summing over all 256 colours, each time a colour was added to
+the list: up to 256 * 256 * 256 multiply-adds per region. Keep the
+scores and add the contribution of the new colour instead. The output
+is unchanged.
+
+Noticed during a review sweep of ffmpeg using an LLM.
+
+Signed-off-by: romainhedouin <romain.hedouin@epitech.eu>
+(cherry picked from commit a1a7737c4bcace8615f70b8f2cc7fc515ca26522)
+---
+ libavcodec/dvbsubdec.c | 10 +++++-----
+ 1 file changed, 5 insertions(+), 5 deletions(-)
+
+diff --git a/libavcodec/dvbsubdec.c b/libavcodec/dvbsubdec.c
+index 0256e8355d..2426da896d 100644
+--- a/libavcodec/dvbsubdec.c
++++ b/libavcodec/dvbsubdec.c
+@@ -673,6 +673,7 @@ static void compute_default_clut(DVBSubContext *ctx, uint8_t *clut, AVSubtitleRe
+     uint8_t list[256] = {0};
+     uint8_t list_inv[256];
+     int counttab[256] = {0};
++    int scoretab[256];
+     int (*counttab2)[256] = ctx->clut_count2;
+     int count, i, x, y;
+     ptrdiff_t stride = rect->linesize[0];
+@@ -699,18 +700,15 @@ static void compute_default_clut(DVBSubContext *ctx, uint8_t *clut, AVSubtitleRe
+     for (i = 0; i<256; i++) {
+         counttab2[i+1][i] = 0;
+     }
++    memcpy(scoretab, counttab2[0], sizeof(scoretab));
+     for (i = 0; i<256; i++) {
+         int bestscore = 0;
+         int bestv = 0;
+ 
+         for (x = 0; x < 256; x++) {
+-            int scorev = 0;
++            int scorev = scoretab[x];
+             if (list[x])
+                 continue;
+-            scorev += counttab2[0][x];
+-            for (y = 0; y < 256; y++) {
+-                scorev += list[y] * counttab2[y+1][x];
+-            }
+ 
+             if (scorev) {
+                 int score = 1024LL*scorev / counttab[x];
+@@ -724,6 +722,8 @@ static void compute_default_clut(DVBSubContext *ctx, uint8_t *clut, AVSubtitleRe
+             break;
+         list    [ bestv ] = 1;
+         list_inv[     i ] = bestv;
++        for (x = 0; x < 256; x++)
++            scoretab[x] += counttab2[bestv+1][x];
+     }
+ 
+     count = FFMAX(i - 1, 1);
diff --git a/packages/ffmpeg-0149-avcodec-flac_parser-score-the-header-chain-without-r.patch b/packages/ffmpeg-0149-avcodec-flac_parser-score-the-header-chain-without-r.patch
new file mode 100644
index 0000000..1a1152f
--- /dev/null
+++ b/packages/ffmpeg-0149-avcodec-flac_parser-score-the-header-chain-without-r.patch
@@ -0,0 +1,93 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Michael Niedermayer <michael@niedermayer.cc>
+Date: Thu, 29 Oct 2026 00:00:23 +0100
+Subject: [PATCH 149/178] avcodec/flac_parser: score the header chain without
+ recursion
+
+Fixes: iEdHjyvZ3jOg
+Fixes: AISLE-2026-0150-00454
+Fixes: stack overflow
+Stack overflow Replicated through API with a 512 KB stack limit
+
+Found-by: Joshua Rogers <joshua.rogers@aisle.com>
+(cherry picked from commit 972fe1ccd326538fe9a6b5d5094b7880b5443429)
+---
+ libavcodec/flac_parser.c | 22 ++++++++++++++++------
+ 1 file changed, 16 insertions(+), 6 deletions(-)
+
+diff --git a/libavcodec/flac_parser.c b/libavcodec/flac_parser.c
+index 9a5f5fd03a..f50b0b262d 100644
+--- a/libavcodec/flac_parser.c
++++ b/libavcodec/flac_parser.c
+@@ -75,6 +75,8 @@ typedef struct FLACHeaderMarker {
+     struct FLACHeaderMarker *next;       /**< next CRC-8 verified header that
+                                               immediately follows this one in
+                                               the bytestream                  */
++    struct FLACHeaderMarker *prev;       /**< CRC-8 verified header that
++                                              immediately precedes this one  */
+     struct FLACHeaderMarker *best_child; /**< following frame header with
+                                               which this frame has the best
+                                               score with                      */
+@@ -321,11 +323,12 @@ static int find_headers_search_validate(FLACParseContext *fpc, int offset)
+                                      &fpc->wrap_buf,
+                                      &fpc->wrap_buf_allocated_size);
+     if (frame_header_is_valid(fpc->avctx, header_buf, &fi)) {
+-        FLACHeaderMarker **end_handle = &fpc->headers;
++        FLACHeaderMarker **end_handle = &fpc->headers, *prev = NULL;
+         int i;
+ 
+         size = 0;
+         while (*end_handle) {
++            prev = *end_handle;
+             end_handle = &(*end_handle)->next;
+             size++;
+         }
+@@ -338,6 +341,7 @@ static int find_headers_search_validate(FLACParseContext *fpc, int offset)
+         }
+         (*end_handle)->fi     = fi;
+         (*end_handle)->offset = offset;
++        (*end_handle)->prev   = prev;
+ 
+         for (i = 0; i < FLAC_MAX_SEQUENTIAL_HEADERS; i++)
+             (*end_handle)->link_penalty[i] = FLAC_HEADER_NOT_PENALIZED_YET;
+@@ -615,15 +619,18 @@ static int score_header(FLACParseContext *fpc, FLACHeaderMarker *header)
+ 
+ static void score_sequences(FLACParseContext *fpc)
+ {
+-    FLACHeaderMarker *curr;
++    FLACHeaderMarker *curr, *last = NULL;
+     int best_score = FLAC_HEADER_NOT_SCORED_YET;
+     /* First pass to clear all old scores. */
+-    for (curr = fpc->headers; curr; curr = curr->next)
++    for (curr = fpc->headers; curr; curr = curr->next) {
+         curr->max_score = FLAC_HEADER_NOT_SCORED_YET;
++        last = curr;
++    }
+ 
+-    /* Do a second pass to score them all. */
+-    for (curr = fpc->headers; curr; curr = curr->next) {
+-        if (score_header(fpc, curr) > best_score) {
++    /* Score from the last header backwards, so the children of each header
++       are already scored and score_header() does not recurse. */
++    for (curr = last; curr; curr = curr->prev) {
++        if (score_header(fpc, curr) >= best_score) {
+             fpc->best_header = curr;
+             best_score       = curr->max_score;
+         }
+@@ -728,6 +735,7 @@ static int flac_parse(AVCodecParserContext *s, AVCodecContext *avctx,
+             curr->offset -= best_child->offset;
+ 
+         best_child->offset = 0;
++        best_child->prev   = NULL;
+         fpc->headers       = best_child;
+         if (fpc->nb_headers_buffered >= FLAC_MIN_HEADERS) {
+             fpc->best_header = best_child;
+@@ -744,6 +752,8 @@ static int flac_parse(AVCodecParserContext *s, AVCodecContext *avctx,
+             fpc->nb_headers_buffered--;
+         }
+         fpc->headers = fpc->best_header->next;
++        if (fpc->headers)
++            fpc->headers->prev = NULL;
+         av_freep(&fpc->best_header);
+         fpc->nb_headers_buffered--;
+     }

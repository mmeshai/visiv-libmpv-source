+From: =?UTF-8?q?Behdad=20Esfahbod=20=28=D8=A8=D9=87=D8=AF=D8=A7=D8=AF=20?=
+ =?UTF-8?q?=D8=A7=D8=B3=D9=81=D9=87=D8=A8=D8=AF=29?= <behdad@behdad.org>
+Date: Tue, 10 Nov 2026 10:45:27 +0100
+Subject: [PATCH 2/5] [truetype] Add a frame length check.
+
+This is especially necessary for environments like Windows where `long` is
+32-bit.
+
+* src/truetype/ttgxvar.c (tt_var_load_item_variation_store): Add guard for
+  variation region list size.
+
+Fixes issue #1484.
+
+(cherry picked from commit f1f3f7d722ba3e1ff5940edc5bad680614d83eda)
+---
+ src/truetype/ttgxvar.c | 11 ++++++++++-
+ 1 file changed, 10 insertions(+), 1 deletion(-)
+
+diff --git a/src/truetype/ttgxvar.c b/src/truetype/ttgxvar.c
+index 6017eaf4d..173e649a0 100644
+--- a/src/truetype/ttgxvar.c
++++ b/src/truetype/ttgxvar.c
+@@ -595,7 +595,16 @@
+       goto Exit;
+     itemStore->regionCount = region_count;
+ 
+-    if ( FT_FRAME_ENTER( (FT_Long)region_count * axis_count * 6 ) )
++    /* a wrapped frame length would under-size the frame below */
++    if ( axis_count && region_count > FT_ULONG_MAX / 6 / axis_count )
++    {
++      FT_TRACE2(( "tt_var_load_item_variation_store:"
++                  " too large variation region list\n" ));
++      error = FT_THROW( Invalid_Table );
++      goto Exit;
++    }
++
++    if ( FT_FRAME_ENTER( (FT_ULong)region_count * axis_count * 6 ) )
+     {
+       FT_TRACE2(( "tt_var_load_item_variation_store:"
+                   " not enough data for variation regions\n" ));
diff --git a/packages/freetype2-0003-truetype-Update-a-frame-length-check.patch b/packages/freetype2-0003-truetype-Update-a-frame-length-check.patch
new file mode 100644
index 0000000..978e293
--- /dev/null
+++ b/packages/freetype2-0003-truetype-Update-a-frame-length-check.patch
@@ -0,0 +1,29 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Alexei Podtelezhnikov <apodtele@gmail.com>
+Date: Tue, 10 Nov 2026 20:03:01 -0500
+Subject: [PATCH 3/5] [truetype] Update a frame length check.
+
+Both 'region_count' and 'axis_count' are read as USHORT with the
+former further capped at 32767. Their product will never overflow.
+It is the multiplication by 6 that does it.
+
+* src/truetype/ttgxvar.c (tt_var_load_item_variation_store): Update.
+
+(cherry picked from commit 8f4b128d69669809f3f020790ce76cbf897337d3)
+---
+ src/truetype/ttgxvar.c | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/src/truetype/ttgxvar.c b/src/truetype/ttgxvar.c
+index 173e649a0..6d4b4fc4c 100644
+--- a/src/truetype/ttgxvar.c
++++ b/src/truetype/ttgxvar.c
+@@ -596,7 +596,7 @@
+     itemStore->regionCount = region_count;
+ 
+     /* a wrapped frame length would under-size the frame below */
+-    if ( axis_count && region_count > FT_ULONG_MAX / 6 / axis_count )
++    if ( axis_count && region_count * axis_count > FT_ULONG_MAX / 6 )
+     {
+       FT_TRACE2(( "tt_var_load_item_variation_store:"
+                   " too large variation region list\n" ));

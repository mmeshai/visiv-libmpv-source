diff --git a/packages/zlib-0001-Reject-an-invalid-zlib-window-size-before-saving-it-.patch b/packages/zlib-0001-Reject-an-invalid-zlib-window-size-before-saving-it-.patch
new file mode 100644
index 0000000..84e1f04
--- /dev/null
+++ b/packages/zlib-0001-Reject-an-invalid-zlib-window-size-before-saving-it-.patch
@@ -0,0 +1,218 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Bernhard Rosenkraenzer <bero@lindev.ch>
+Date: Sun, 8 Nov 2026 23:04:12 +0100
+Subject: [PATCH 1/4] Reject an invalid zlib window size before saving it
+ (#2498)
+
+* Reject an invalid zlib window size before saving it
+
+An invalid CINFO was written to wbits and then rejected. inflateReset
+leaves wbits alone, and the window buffer is allocated at 32K, so the
+next inflate with windowBits 0 copied past that buffer.
+
+(cherry picked from commit 1bfa59ae103efa858ccfb16c75d4767603ea954e)
+---
+ inflate.c                |   7 +-
+ test/test_inflate_cve.cc | 164 +++++++++++++++++++++++++++++++++++++++
+ 2 files changed, 168 insertions(+), 3 deletions(-)
+
+diff --git a/inflate.c b/inflate.c
+index 60dd2e6e..ba635d1e 100644
+--- a/inflate.c
++++ b/inflate.c
+@@ -538,12 +538,13 @@ int32_t Z_EXPORT PREFIX(inflate)(PREFIX3(stream) *strm, int32_t flush) {
+             }
+             DROPBITS(4);
+             len = BITS(4) + 8;
+-            if (state->wbits == 0)
+-                state->wbits = len;
+-            if (len > MAX_WBITS || len > state->wbits) {
++            /* Reject before storing, so a bad CINFO cannot stick in wbits. */
++            if (len > MAX_WBITS || (state->wbits != 0 && len > state->wbits)) {
+                 SET_BAD("invalid window size");
+                 break;
+             }
++            if (state->wbits == 0)
++                state->wbits = len;
+ #ifdef INFLATE_STRICT
+             state->dmax = 1U << len;
+ #endif
+diff --git a/test/test_inflate_cve.cc b/test/test_inflate_cve.cc
+index 303eacde..f931aa53 100644
+--- a/test/test_inflate_cve.cc
++++ b/test/test_inflate_cve.cc
+@@ -8,6 +8,7 @@
+ #endif
+ 
+ #include <stdint.h>
++#include <stdlib.h>
+ #include <string.h>
+ 
+ #include <gtest/gtest.h>
+@@ -103,3 +104,166 @@ TEST(inflate, cve_2005_1849) {
+ TEST(inflate, cve_2005_2096) {
+     inflate_malformed(cve_2005_2096, (uint32_t)sizeof(cve_2005_2096));
+ }
++
++/* CINFO 8..15 used to be stored in wbits before it was rejected. inflateReset()
++ * keeps wbits, and the next stream then copied past the 32K window. */
++TEST(inflate, invalid_cinfo_does_not_stick) {
++    const size_t n = 128 * 1024;
++    PREFIX3(stream) strm, comp;
++    uint8_t hdr[2];
++    uint8_t *src, *dst, *compressed;
++    uint32_t dictlen;
++    unsigned long bound = 0;
++    size_t produced = 0;
++    int err = Z_OK;
++    int comp_open = 0;
++    int strm_open = 0;
++
++    src = (uint8_t *)calloc(1, n);
++    dst = (uint8_t *)malloc(n);
++    compressed = nullptr;
++    /* One release point. scan-build treats ASSERT/FAIL as a return and
++     * also as a fall-through, so freeing on both paths is a double free. */
++    if (src == nullptr || dst == nullptr) {
++        ADD_FAILURE() << "out of memory";
++        goto done;
++    }
++
++    memset(&comp, 0, sizeof(comp));
++    err = PREFIX(deflateInit)(&comp, 1);
++    if (err != Z_OK) {
++        ADD_FAILURE() << "deflateInit returned " << err;
++        goto done;
++    }
++    comp_open = 1;
++    bound = PREFIX(deflateBound)(&comp, (unsigned long)n);
++    compressed = (uint8_t *)malloc(bound);
++    if (compressed == nullptr) {
++        ADD_FAILURE() << "out of memory";
++        goto done;
++    }
++    comp.next_in = src;
++    comp.avail_in = (uint32_t)n;
++    comp.next_out = compressed;
++    comp.avail_out = (uint32_t)bound;
++    err = PREFIX(deflate)(&comp, Z_FINISH);
++    bound = (unsigned long)comp.total_out;
++    PREFIX(deflateEnd)(&comp);
++    comp_open = 0;
++    if (err != Z_STREAM_END) {
++        ADD_FAILURE() << "deflate returned " << err;
++        goto done;
++    }
++
++    memset(&strm, 0, sizeof(strm));
++    err = PREFIX(inflateInit2)(&strm, 0);
++    if (err != Z_OK) {
++        ADD_FAILURE() << "inflateInit2 returned " << err;
++        goto done;
++    }
++    strm_open = 1;
++
++    /* CMF CINFO 15, CM 8. 0xF800 is divisible by 31, so FLG is 0. */
++    hdr[0] = 0xf8;
++    hdr[1] = 0x00;
++    strm.next_in = hdr;
++    strm.avail_in = sizeof(hdr);
++    strm.next_out = dst;
++    strm.avail_out = 64;
++    EXPECT_EQ(PREFIX(inflate)(&strm, Z_NO_FLUSH), Z_DATA_ERROR);
++
++    err = PREFIX(inflateReset)(&strm);
++    if (err != Z_OK) {
++        ADD_FAILURE() << "inflateReset returned " << err;
++        goto done;
++    }
++    strm.next_in = compressed;
++    strm.avail_in = (uint32_t)bound;
++    produced = 0;
++    do {
++        strm.next_out = dst + produced;
++        strm.avail_out = (uint32_t)MIN(n - produced, (size_t)64 * 1024);
++        err = PREFIX(inflate)(&strm, Z_NO_FLUSH);
++        produced = (size_t)strm.total_out;
++        if (produced > n) {
++            ADD_FAILURE() << "inflate wrote " << produced << " bytes into " << n;
++            goto done;
++        }
++    } while (err == Z_OK);
++
++    EXPECT_EQ(err, Z_STREAM_END);
++    EXPECT_EQ(produced, n);
++    EXPECT_EQ(memcmp(src, dst, n), 0);
++    dictlen = 0;
++    /* NULL dictionary: only the length is written, and it stays within the 32K window. */
++    EXPECT_EQ(PREFIX(inflateGetDictionary)(&strm, NULL, &dictlen), Z_OK);
++    EXPECT_LE(dictlen, 32768u);
++
++done:
++    if (strm_open) {
++        EXPECT_EQ(PREFIX(inflateEnd)(&strm), Z_OK);
++    }
++    if (comp_open) {
++        PREFIX(deflateEnd)(&comp);
++    }
++    free(compressed);
++    free(dst);
++    free(src);
++}
++
++/* windowBits 0 still takes a valid size from the zlib header. */
++TEST(inflate, window_size_from_header) {
++    PREFIX3(stream) strm, comp;
++    uint8_t src[64], dst[64], compressed[128];
++    unsigned long bound;
++    int i;
++
++    for (i = 0; i < (int)sizeof(src); i++)
++        src[i] = (uint8_t)(i * 3 + 1);
++
++    memset(&comp, 0, sizeof(comp));
++    ASSERT_EQ(PREFIX(deflateInit)(&comp, Z_DEFAULT_COMPRESSION), Z_OK);
++    comp.next_in = src;
++    comp.avail_in = sizeof(src);
++    comp.next_out = compressed;
++    comp.avail_out = sizeof(compressed);
++    ASSERT_EQ(PREFIX(deflate)(&comp, Z_FINISH), Z_STREAM_END);
++    bound = (unsigned long)comp.total_out;
++    PREFIX(deflateEnd)(&comp);
++
++    memset(&strm, 0, sizeof(strm));
++    ASSERT_EQ(PREFIX(inflateInit2)(&strm, 0), Z_OK);
++    strm.next_in = compressed;
++    strm.avail_in = (uint32_t)bound;
++    strm.next_out = dst;
++    strm.avail_out = sizeof(dst);
++    EXPECT_EQ(PREFIX(inflate)(&strm, Z_FINISH), Z_STREAM_END);
++    EXPECT_EQ(memcmp(src, dst, sizeof(src)), 0);
++    EXPECT_EQ(PREFIX(inflateEnd)(&strm), Z_OK);
++}
++
++/* A header window larger than the one the caller asked for stays an error. */
++TEST(inflate, header_window_exceeds_request) {
++    PREFIX3(stream) strm, comp;
++    uint8_t src[32], dst[32], compressed[64];
++
++    memset(src, 0x11, sizeof(src));
++    memset(&comp, 0, sizeof(comp));
++    ASSERT_EQ(PREFIX(deflateInit)(&comp, Z_DEFAULT_COMPRESSION), Z_OK);
++    comp.next_in = src;
++    comp.avail_in = sizeof(src);
++    comp.next_out = compressed;
++    comp.avail_out = sizeof(compressed);
++    ASSERT_EQ(PREFIX(deflate)(&comp, Z_FINISH), Z_STREAM_END);
++    unsigned long bound = (unsigned long)comp.total_out;
++    PREFIX(deflateEnd)(&comp);
++
++    memset(&strm, 0, sizeof(strm));
++    ASSERT_EQ(PREFIX(inflateInit2)(&strm, 10), Z_OK);
++    strm.next_in = compressed;
++    strm.avail_in = (uint32_t)bound;
++    strm.next_out = dst;
++    strm.avail_out = sizeof(dst);
++    EXPECT_EQ(PREFIX(inflate)(&strm, Z_NO_FLUSH), Z_DATA_ERROR);
++    EXPECT_EQ(PREFIX(inflateEnd)(&strm), Z_OK);
++}
diff --git a/packages/zlib-0002-Reject-a-too-far-distance-in-inflateBack-s-fast-path.patch b/packages/zlib-0002-Reject-a-too-far-distance-in-inflateBack-s-fast-path.patch
new file mode 100644
index 0000000..87ca4d5
--- /dev/null
+++ b/packages/zlib-0002-Reject-a-too-far-distance-in-inflateBack-s-fast-path.patch
@@ -0,0 +1,171 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Bernhard Rosenkraenzer <bero@lindev.ch>
+Date: Mon, 9 Nov 2026 15:13:13 +0100
+Subject: [PATCH 2/4] Reject a too-far distance in inflateBack's fast path
+ (#2497)
+
+inflateBack set whave to wsize - left before calling inflate_fast.
+Bytes already written in the current window are not history before
+the window, so a distance that starts before the real history copied
+uninitialized bytes and the stream was accepted.
+
+zlib 1.4 removed that assignment. On develop the slow path already
+rejects the distance; the fast path still applied the assignment
+first, so the check never saw it.
+
+A stored byte followed by a fixed-block distance of 2 now returns
+Z_DATA_ERROR when enough input is left to enter inflate_fast. A
+distance that stays inside the bytes just written still round-trips.
+
+(cherry picked from commit 58645370be65a6d21b2822b2c136bb0be41dee62)
+---
+ infback.c                 |   2 -
+ test/test_inflate_back.cc | 125 ++++++++++++++++++++++++++++++++++++++
+ 2 files changed, 125 insertions(+), 2 deletions(-)
+
+diff --git a/infback.c b/infback.c
+index 767604cf..3167c901 100644
+--- a/infback.c
++++ b/infback.c
+@@ -365,8 +365,6 @@ int32_t Z_EXPORT PREFIX(inflateBack)(PREFIX3(stream) *strm, PREFIX(in_func) in,
+             /* use inflate_fast() if we have enough input and output */
+             if (have >= INFLATE_FAST_MIN_HAVE && left >= INFLATE_FAST_MIN_SAFE) {
+                 RESTORE();
+-                if (state->whave < state->wsize)
+-                    state->whave = state->wsize - left;
+                 /* inflateBack() writes directly into the window, so out and window
+                    always overlap. Use the safe variant, whose chunk copy functions
+                    never overwrite window data needed by future back-references. */
+diff --git a/test/test_inflate_back.cc b/test/test_inflate_back.cc
+index fea4f341..4c8535a6 100644
+--- a/test/test_inflate_back.cc
++++ b/test/test_inflate_back.cc
+@@ -195,3 +195,128 @@ TEST_F(inflate_back, match_state_invalid_distance) {
+     PREFIX(inflateBackEnd)(&d_strm);
+     free(small_window);
+ }
++
++namespace {
++
++/* Raw deflate: a stored 0xA5, then a final fixed block that copies 3 bytes. */
++class raw_bits {
++public:
++    void put(uint32_t val, unsigned n) {
++        for (unsigned i = 0; i < n; i++) {
++            if (val & 1)
++                data[nbit >> 3] |= (uint8_t)(1u << (nbit & 7));
++            val >>= 1;
++            nbit++;
++        }
++    }
++
++    /* Huffman codes are packed most-significant bit first. */
++    void huff(uint32_t code, unsigned n) {
++        for (int i = (int)n - 1; i >= 0; i--)
++            put((code >> i) & 1, 1);
++    }
++
++    unsigned size() const {
++        return (nbit + 7) >> 3;
++    }
++
++    uint8_t data[32] = {};
++    unsigned nbit = 0;
++};
++
++static unsigned craft_stored_then_match(uint8_t *out, unsigned dist) {
++    raw_bits b;
++
++    b.put(0, 1);             /* BFINAL */
++    b.put(0, 2);             /* stored */
++    while (b.nbit & 7)
++        b.put(0, 1);
++    b.put(1, 16);            /* LEN */
++    b.put(0xffffu ^ 1u, 16); /* NLEN */
++    b.put(0xa5, 8);
++
++    b.put(1, 1);             /* final */
++    b.put(1, 2);             /* fixed */
++    b.huff(1, 7);            /* length symbol 257: 3 bytes, code 0000001 */
++    b.huff(dist - 1, 5);     /* distance symbol, no extra bits for 1 or 2 */
++    b.huff(0, 7);            /* end of block */
++
++    unsigned n = b.size();
++    memcpy(out, b.data, n);
++    return n;
++}
++
++static int inflate_back_raw(const uint8_t *raw, unsigned n, unsigned pad, uint8_t *decoded, unsigned *produced) {
++    const int wbits = 15;
++    uint8_t *window = (uint8_t *)malloc(1u << wbits);
++    uint8_t input[96];
++    PREFIX3(stream) strm;
++    struct output_state out;
++    int err;
++
++    if (window == NULL)
++        return Z_MEM_ERROR;
++    memset(window, 0x5a, 1u << wbits);
++    memcpy(input, raw, n);
++    if (pad)
++        memset(input + n, 0, pad);
++
++    memset(&strm, 0, sizeof(strm));
++    err = PREFIX(inflateBackInit)(&strm, wbits, window);
++    if (err != Z_OK) {
++        free(window);
++        return err;
++    }
++    strm.next_in = input;
++    strm.avail_in = n + pad;
++    out.buf = decoded;
++    out.size = 64;
++    out.pos = 0;
++
++    err = PREFIX(inflateBack)(&strm, pull_all, &strm, push_all, &out);
++    PREFIX(inflateBackEnd)(&strm);
++    free(window);
++    *produced = (unsigned)out.pos;
++    return err;
++}
++
++}  // namespace
++
++/* One byte exists. A distance of 2 starts before that byte. Enough trailing
++ * input is left that inflateBack() takes inflate_fast(), which used to treat
++ * the byte already written in this window as history before the window. */
++TEST(inflate_back_distance, too_far_before_fast_path) {
++    uint8_t raw[32];
++    uint8_t decoded[64];
++    unsigned n = craft_stored_then_match(raw, 2);
++    unsigned produced = 0;
++
++    EXPECT_EQ(inflate_back_raw(raw, n, 32, decoded, &produced), Z_DATA_ERROR);
++}
++
++/* Same stream with too little input for inflate_fast(). 2.3.x only checked
++ * this when INFLATE_STRICT was enabled; develop already checks it. */
++TEST(inflate_back_distance, too_far_on_slow_path) {
++    uint8_t raw[32];
++    uint8_t decoded[64];
++    unsigned n = craft_stored_then_match(raw, 2);
++    unsigned produced = 0;
++
++    ASSERT_LT(n, 15u);
++    EXPECT_EQ(inflate_back_raw(raw, n, 0, decoded, &produced), Z_DATA_ERROR);
++}
++
++/* A distance that stays inside the bytes just written is valid on either path. */
++TEST(inflate_back_distance, match_inside_output) {
++    uint8_t raw[32];
++    uint8_t decoded[64];
++    unsigned n = craft_stored_then_match(raw, 1);
++    unsigned produced = 0;
++
++    EXPECT_EQ(inflate_back_raw(raw, n, 32, decoded, &produced), Z_STREAM_END);
++    ASSERT_EQ(produced, 4u);
++    EXPECT_EQ(decoded[0], 0xa5);
++    EXPECT_EQ(decoded[1], 0xa5);
++    EXPECT_EQ(decoded[2], 0xa5);
++    EXPECT_EQ(decoded[3], 0xa5);
++}
diff --git a/packages/zlib-0003-Restore-requested-inflate-window-on-reset.patch b/packages/zlib-0003-Restore-requested-inflate-window-on-reset.patch
new file mode 100644
index 0000000..37a0024
--- /dev/null
+++ b/packages/zlib-0003-Restore-requested-inflate-window-on-reset.patch
@@ -0,0 +1,66 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: "ronald.eytchison@trailofbits.com" <ronald.eytchison@trailofbits.com>
+Date: Fri, 5 Jun 2026 19:10:16 +0000
+Subject: [PATCH 3/4] Restore requested inflate window on reset.
+
+inflateReset() did not restore a windowBits request of 0 or 32, so
+a reused stream would keep the window size from the previous
+stream's header, and a later stream needing a larger window would
+be rejected.
+
+Reported by Trail of Bits (TOB-ZLIB-007).
+
+zlib-ng allocates the window with the inflate state, so only wbits
+is restored here and the window is not freed. reqbits sits in the
+tail padding of the state, so the window and bit buffer fields keep
+their offsets.
+
+Upstream: https://github.com/madler/zlib/commit/c0424159
+(cherry picked from commit 882a6e39ead79f628d0e78f5f9666aa5d644b62a)
+---
+ inflate.c | 3 ++-
+ inflate.h | 3 ++-
+ 2 files changed, 4 insertions(+), 2 deletions(-)
+
+diff --git a/inflate.c b/inflate.c
+index ba635d1e..d433e095 100644
+--- a/inflate.c
++++ b/inflate.c
+@@ -98,6 +98,7 @@ int32_t Z_EXPORT PREFIX(inflateReset)(PREFIX3(stream) *strm) {
+     if (inflateStateCheck(strm))
+         return Z_STREAM_ERROR;
+     state = (struct inflate_state *)strm->state;
++    state->wbits = state->reqbits;
+     state->wsize = 0;
+     state->whave = 0;
+     state->wnext = 0;
+@@ -133,7 +134,7 @@ int32_t Z_EXPORT PREFIX(inflateReset2)(PREFIX3(stream) *strm, int32_t windowBits
+ 
+     /* update state and reset the rest of it */
+     state->wrap = wrap;
+-    state->wbits = (unsigned)windowBits;
++    state->reqbits = state->wbits = (unsigned)windowBits;
+     return PREFIX(inflateReset)(strm);
+ }
+ 
+diff --git a/inflate.h b/inflate.h
+index a854f606..16df6476 100644
+--- a/inflate.h
++++ b/inflate.h
+@@ -110,7 +110,7 @@ struct ALIGNED_(64) inflate_state {
+     int back;                   /* bits back of last unprocessed length/lit */
+ 
+         /* sliding window */
+-    unsigned wbits;             /* log base 2 of requested window size */
++    unsigned wbits;             /* current log base 2 of window size */
+     uint32_t wsize;             /* window size or zero if not using window */
+     uint32_t wbufsize;          /* real size of the allocated window buffer, including padding */
+     uint32_t whave;             /* valid bytes in the window */
+@@ -142,6 +142,7 @@ struct ALIGNED_(64) inflate_state {
+     code codes[ENOUGH];         /* space for code tables */
+ 
+     inflate_allocs *alloc_bufs; /* struct for handling memory allocations */
++    unsigned reqbits;           /* requested log base 2 of window size */
+ 
+ #ifdef INFLATE_STRICT
+     unsigned dmax;              /* zlib header max distance (INFLATE_STRICT) */
diff --git a/packages/zlib-0004-Use-the-maximum-window-size-after-inflateSync-if-not.patch b/packages/zlib-0004-Use-the-maximum-window-size-after-inflateSync-if-not.patch
new file mode 100644
index 0000000..33e41d7
--- /dev/null
+++ b/packages/zlib-0004-Use-the-maximum-window-size-after-inflateSync-if-not.patch
@@ -0,0 +1,39 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Mark Adler <git@madler.net>
+Date: Mon, 26 Oct 2026 14:14:33 -0700
+Subject: [PATCH 4/4] Use the maximum window size after inflateSync() if not
+ yet known.
+
+With windowBits 0, inflate() learns the window size from the zlib
+or gzip header. If inflateSync() recovered before any header was
+processed, decoding continued with a window size of zero, which
+allocated a one-byte window. Back-references longer than the output
+buffer then failed with "invalid distance too far back", and if the
+stream was reused, a header that set the window size would make
+updatewindow() write past that one-byte allocation.
+
+Reported by Trail of Bits (TOB-ZLIB-004).
+
+zlib-ng allocates the window with the inflate state, so only wbits
+is changed here and the window is not freed.
+
+Upstream: https://github.com/madler/zlib/commit/8179479c
+(cherry picked from commit b8f360933367023d2711001ae67cc966902bf500)
+---
+ inflate.c | 3 +++
+ 1 file changed, 3 insertions(+)
+
+diff --git a/inflate.c b/inflate.c
+index d433e095..9c88b536 100644
+--- a/inflate.c
++++ b/inflate.c
+@@ -1361,6 +1361,9 @@ int32_t Z_EXPORT PREFIX(inflateSync)(PREFIX3(stream) *strm) {
+     strm->total_in = (z_uintmax_t)in; /* Can't use z_size_t here as it will overflow on 64-bit Windows */
+     strm->total_out = (z_uintmax_t)out;
+     state->flags = flags;
++    /* we never got to see a header for the window size -- set to max */
++    if (state->wbits == 0)
++        state->wbits = MAX_WBITS;
+     state->mode = TYPE;
+     return Z_OK;
+ }
diff --git a/packages/zlib.cmake b/packages/zlib.cmake
index 5a1aa65..53a2789 100644
--- a/packages/zlib.cmake
+++ b/packages/zlib.cmake
@@ -3,6 +3,8 @@ ExternalProject_Add(zlib
     SOURCE_DIR ${SOURCE_LOCATION}
     GIT_CLONE_FLAGS "--filter=tree:0"
     UPDATE_COMMAND ""
+    # visiv 13.11.2026: Sicherheits-Rueckports aus Upstream (Fable-Lagebild Rueckports), je zeilengleich
+    PATCH_COMMAND ${EXEC} git am --3way ${CMAKE_CURRENT_SOURCE_DIR}/zlib-*.patch
     GIT_REMOTE_NAME origin
     GIT_TAG develop
     CONFIGURE_COMMAND ${EXEC} CONF=1 cmake -H<SOURCE_DIR> -B<BINARY_DIR>

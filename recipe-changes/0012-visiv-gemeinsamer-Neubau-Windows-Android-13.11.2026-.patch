diff --git a/packages/libunibreak-0001-Fix-out-of-bounds-brks-1-write-when-LB15b-arms-durin.patch b/packages/libunibreak-0001-Fix-out-of-bounds-brks-1-write-when-LB15b-arms-durin.patch
new file mode 100644
index 0000000..86612b8
--- /dev/null
+++ b/packages/libunibreak-0001-Fix-out-of-bounds-brks-1-write-when-LB15b-arms-durin.patch
@@ -0,0 +1,73 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Wu Yongwei <wuyongwei@gmail.com>
+Date: Wed, 4 Nov 2026 00:11:25 +0800
+Subject: [PATCH] Fix out-of-bounds brks[-1] write when LB15b arms during
+ LB15c/LB19a revert
+
+When a character both resolves a pending LB15c/LB19a lookahead break and
+arms a new LB15b break, lb_process_next_char() overwrites posPending and
+cPendingOrigBrk before set_linebreaks runs the revert.  The revert then
+used the newly-armed break's position: the earlier tentative break was
+never reverted, and when the LB15b break later resolved with posPending
+== INVALID_POS, the revert wrote brks[(size_t)-1], one byte before the
+caller's buffer.
+
+Snapshot the pending position and value before lb_process_next_char() and
+revert with the saved copies; a break this character armed keeps its own.
+
+Add LineBreakExtraTest.txt with the two reported cases (LB15b over LB15c
+and LB15b over LB19a) and run it from make check.
+
+This fixes #50.
+
+[visiv: backported to libunibreak 8.0 - only src/linebreak.c (unchanged); the new
+ test data src/LineBreakExtraTest.txt and its src/Makefile.am lines are left out,
+ the tests program of 8.0 takes no test file argument]
+(cherry picked from commit 2c5205aa35902c440dbdc523c9f319f710750716)
+---
+ src/linebreak.c | 15 ++++++++++++---
+ 1 file changed, 12 insertions(+), 3 deletions(-)
+
+diff --git a/src/linebreak.c b/src/linebreak.c
+index e15e4c2..1731369 100644
+--- a/src/linebreak.c
++++ b/src/linebreak.c
+@@ -1444,6 +1444,8 @@ size_t set_linebreaks(
+     struct LineBreakContext lbCtx;
+     size_t posCur = 0;
+     size_t posLast = 0;
++    size_t posRevert;
++    char cRevertOrigBrk;
+ 
+     --posLast;  /* To be ++'d later */
+     ch = get_next_char(s, len, &posCur);
+@@ -1474,6 +1476,12 @@ size_t set_linebreaks(
+             break;
+         }
+         lbCtx.posLast = posLast;
++        /* The tentative break this character resolves, saved before
++         * lb_process_next_char can arm another one (e.g. LB15b after
++         * LB15c or LB19a), which overwrites posPending and
++         * cPendingOrigBrk. */
++        posRevert = lbCtx.posPending;
++        cRevertOrigBrk = lbCtx.cPendingOrigBrk;
+         brks[posLast] = (char)lb_process_next_char(&lbCtx, ch);
+ 
+         /* Fix-up due to LB25 */
+@@ -1484,12 +1492,13 @@ size_t set_linebreaks(
+             lbCtx.fLb25Mark = false;
+         }
+ 
+-        /* Fix-up (revert) due to a pending lookahead break */
++        /* Fix-up (revert) due to a pending lookahead break, at the
++         * position saved above; a pending break this character armed
++         * keeps its own position and value. */
+         if (lbCtx.fPendingRevert)
+         {
+-            brks[lbCtx.posPending] = lbCtx.cPendingOrigBrk;
++            brks[posRevert] = cRevertOrigBrk;
+             lbCtx.fPendingRevert = false;
+-            lbCtx.posPending = INVALID_POS;
+         }
+     }
+ 

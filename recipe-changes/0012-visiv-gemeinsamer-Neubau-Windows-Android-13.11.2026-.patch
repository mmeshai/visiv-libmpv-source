diff --git a/packages/mpv-0005-hwdec_aimagereader-reduce-maxImages-for-reader-to-3.patch b/packages/mpv-0005-hwdec_aimagereader-reduce-maxImages-for-reader-to-3.patch
new file mode 100644
index 0000000..539bda0
--- /dev/null
+++ b/packages/mpv-0005-hwdec_aimagereader-reduce-maxImages-for-reader-to-3.patch
@@ -0,0 +1,38 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: sfan5 <sfan5@live.de>
+Date: Sun, 6 Sep 2026 19:00:56 +0200
+Subject: [PATCH 5/7] hwdec_aimagereader: reduce maxImages for reader to 3
+
+In https://github.com/mpv-android/mpv-android/issues/540 we have
+reports that a value of "5" is too high on a Fire TV Stick 4K Max (MediaTek-based).
+The problem only surfaces later when trying to initialize the decoder.
+
+[ffmpeg:error] amediacodec: java.lang.IllegalArgumentException: start failed
+[ffmpeg/video:error] hevc_mediacodec: Failed to start codec OMX.MTK.VIDEO.DECODER.HEVC (status = -542398533) with format [...]
+
+(cherry picked from commit c8d3f6884dd4c4725bae18f72dcf48163b512ea8)
+---
+ video/out/hwdec/hwdec_aimagereader.c | 7 ++++++-
+ 1 file changed, 6 insertions(+), 1 deletion(-)
+
+diff --git a/video/out/hwdec/hwdec_aimagereader.c b/video/out/hwdec/hwdec_aimagereader.c
+index 83c2ea87ef..d356735ccb 100644
+--- a/video/out/hwdec/hwdec_aimagereader.c
++++ b/video/out/hwdec/hwdec_aimagereader.c
+@@ -153,10 +153,15 @@ static int init(struct ra_hwdec *hw)
+     else
+         hw->glsl_extensions = es2_exts;
+ 
++    // This sets the upper bound for AImages we can acquire from this reader
++    // (incl. ones currently queued) at the same time.
++    // The documentation recommends a margin of 2 for acquireLatestImage to
++    // work correctly.
++    const int max_images = 3;
+     // dummy dimensions, AImageReader only transports hardware buffers
+     media_status_t ret = p->AImageReader_newWithUsage(16, 16,
+         AIMAGE_FORMAT_PRIVATE, AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE,
+-        5, &p->reader);
++        max_images, &p->reader);
+     if (ret != AMEDIA_OK) {
+         MP_ERR(hw, "newWithUsage failed: %d\n", ret);
+         return -1;
diff --git a/packages/mpv-0006-demux_mkv-zero-the-padding-of-LZO-input-buffers.patch b/packages/mpv-0006-demux_mkv-zero-the-padding-of-LZO-input-buffers.patch
new file mode 100644
index 0000000..fa44f97
--- /dev/null
+++ b/packages/mpv-0006-demux_mkv-zero-the-padding-of-LZO-input-buffers.patch
@@ -0,0 +1,48 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
+Date: Wed, 4 Nov 2026 20:02:23 +0100
+Subject: [PATCH 6/7] demux_mkv: zero the padding of LZO input buffers
+
+CodecPrivate and the zlib and LZO outputs can be the input of
+av_lzo1x_decode(), which reads the AV_LZO_INPUT_PADDING bytes after
+them. Zero those bytes like the padding of the block data.
+
+(cherry picked from commit 858e0e50872b163a6fdf7a5477cd6d282d4d5f6f)
+---
+ demux/demux_mkv.c | 9 +++++++++
+ 1 file changed, 9 insertions(+)
+
+diff --git a/demux/demux_mkv.c b/demux/demux_mkv.c

++                               AVExifMetadata *ifd, int guess)
+ {
+     uint32_t entries;
+     size_t required_size;
+@@ -587,6 +591,13 @@ static int exif_parse_ifd_list(void *logctx, GetByteContext *gb, int le,
+         ret = AVERROR_INVALIDDATA;
+         goto end;
+     }
++    if (entries > entries_left[guess]) {

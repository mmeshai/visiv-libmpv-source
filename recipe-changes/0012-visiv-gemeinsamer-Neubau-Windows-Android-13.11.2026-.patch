+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
+Date: Wed, 14 Oct 2026 10:16:49 +0200
+Subject: [PATCH 115/178] avformat: skip the program lookup in av_new_program()
+ for monotonic ids
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+Track whether the program ids are strictly increasing, like
+avpriv_new_chapter() does, and skip the scan of the existing programs
+when the new id is above the last one.
+
+Fixes: Timeout (7s -> 240ms)
+Fixes: clusterfuzz-testcase-ffmpeg_dem_HLS_fuzzer-5202060644253696
+Signed-off-by: Kacper Michajłow <kasper93@gmail.com>
+(cherry picked from commit c37079067e160a165f7f3b3ce93ce6c480b0d700)
+---
+ libavformat/avformat.c | 13 ++++++++++---
+ libavformat/internal.h |  5 +++++
+ 2 files changed, 15 insertions(+), 3 deletions(-)
+
+diff --git a/libavformat/avformat.c b/libavformat/avformat.c
+index 8a98f2e53e..e30db5e313 100644
+--- a/libavformat/avformat.c
++++ b/libavformat/avformat.c
+@@ -270,14 +270,21 @@ const char *avformat_stream_group_name(enum AVStreamGroupParamsType type)
+ 
+ AVProgram *av_new_program(AVFormatContext *ac, int id)
+ {
++    FFFormatContext *const si = ffformatcontext(ac);
+     AVProgram *program = NULL;
+     int ret;
+ 
+     av_log(ac, AV_LOG_TRACE, "new_program: id=0x%04x\n", id);
+ 
+-    for (unsigned i = 0; i < ac->nb_programs; i++)
+-        if (ac->programs[i]->id == id)
+-            program = ac->programs[i];
++    if (!ac->nb_programs) {
++        si->program_ids_monotonic = 1;
++    } else if (!si->program_ids_monotonic || ac->programs[ac->nb_programs - 1]->id >= id) {
++        for (unsigned i = 0; i < ac->nb_programs; i++)
++            if (ac->programs[i]->id == id)
++                program = ac->programs[i];
++        if (!program)
++            si->program_ids_monotonic = 0;
++    }
+ 
+     if (!program) {
+         program = av_mallocz(sizeof(*program));
+diff --git a/libavformat/internal.h b/libavformat/internal.h
+index 89251b2460..8e2b03b262 100644
+--- a/libavformat/internal.h
++++ b/libavformat/internal.h
+@@ -112,6 +112,11 @@ typedef struct FFFormatContext {
+ 
+     int avoid_negative_ts_use_pts;
+ 
++    /**
++     * Set if program ids are strictly monotonic.
++     */
++    int program_ids_monotonic;
++
+     /**
+      * ID3v2 tag useful for MP3 demuxing
+      */

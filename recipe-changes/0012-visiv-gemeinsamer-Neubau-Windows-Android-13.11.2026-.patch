@@ -0,0 +1,59 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
+Date: Thu, 15 Oct 2026 17:24:32 +0200
+Subject: [PATCH 113/178] avformat/dashdec: bound the root URL copy by the size
+ of tmp_str
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+Allocate tmp_str with room for the slash appended to the root URL and
+the terminating null, like path, and bound the copy of the root URL and
+the BaseURL concatenation by that size instead of by the length of the
+root URL.
+
+Signed-off-by: Kacper Michajłow <kasper93@gmail.com>
+(cherry picked from commit c64a6bdbf009d53ef09fbc634aff77348e22e32b)
+---
+ libavformat/dashdec.c | 7 +++----
+ 1 file changed, 3 insertions(+), 4 deletions(-)
+
+diff --git a/libavformat/dashdec.c b/libavformat/dashdec.c
+index d045e52043..44fdfe461f 100644
+--- a/libavformat/dashdec.c
++++ b/libavformat/dashdec.c
+@@ -756,7 +756,7 @@ static int resolve_content_path(AVFormatContext *s, const char *url, int *max_ur
+     av_free(text);
+ 
+     path = av_mallocz(tmp_max_url_size + 2);
+-    tmp_str = av_mallocz(tmp_max_url_size);
++    tmp_str = av_mallocz(tmp_max_url_size + 2);
+     if (!tmp_str || !path) {
+         updated = AVERROR(ENOMEM);
+         goto end;
+@@ -803,7 +803,6 @@ static int resolve_content_path(AVFormatContext *s, const char *url, int *max_ur
+ 
+     if (size > 0 && root_url[size - 1] != token) {
+         av_strlcat(root_url, "/", size + 2);
+-        size += 2;
+     }
+ 
+     for (i = 0; i < n_baseurl_nodes; ++i) {
+@@ -814,7 +813,7 @@ static int resolve_content_path(AVFormatContext *s, const char *url, int *max_ur
+         if (text && !av_strstart(text, "/", NULL)) {
+             memset(tmp_str, 0, strlen(tmp_str));
+             if (!ishttp(text) && isRootHttp) {
+-                av_strlcpy(tmp_str, root_url, size + 1);
++                av_strlcpy(tmp_str, root_url, tmp_max_url_size + 2);
+             }
+             start = (text[0] == token);
+             if (start && av_stristr(tmp_str, text)) {
+@@ -827,7 +826,7 @@ static int resolve_content_path(AVFormatContext *s, const char *url, int *max_ur
+                 p = strchr(p, '/');
+                 memset(p + 1, 0, strlen(p));
+             }
+-            av_strlcat(tmp_str, text + start, tmp_max_url_size);
++            av_strlcat(tmp_str, text + start, tmp_max_url_size + 2);
+             xmlFree(text);
+             xmlChar* escaped = xmlEncodeSpecialChars(NULL, tmp_str);
+             if (!escaped) {
diff --git a/packages/ffmpeg-0114-avformat-dashdec-free-the-content-of-BaseURL-element.patch b/packages/ffmpeg-0114-avformat-dashdec-free-the-content-of-BaseURL-element.patch

+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Michael Niedermayer <michael@niedermayer.cc>
+Date: Tue, 13 Oct 2026 06:40:15 +0200
+Subject: [PATCH 121/178] avcodec/nvdec: attach the hw_frames_ctx before the
+ unmap buffer owns the mapped frame
+
+This is not a security issue.
+
+Fixes: DPSu3J80jQZN
+Fixes: swarm-NULL-deref-in-nvdec_unmap_mapped_frame-when-av_buffer_replace-fails-5c28b7
+Regression since: 767f53533a
+NULL pointer dereference Replicated through Modified FFmpeg with ASAN (av_buffer_replace() made to fail for one frame)
+Found-by: zhang xingxing <2388969553@qq.com>
+Signed-off-by: Michael Niedermayer <michael@niedermayer.cc>
+(cherry picked from commit c2bbf2b83d064313ca3739f81c651553cfbb26fb)
+---
+ libavcodec/nvdec.c | 16 ++++++----------
+ 1 file changed, 6 insertions(+), 10 deletions(-)
+
+diff --git a/libavcodec/nvdec.c b/libavcodec/nvdec.c
+index 0774fb4d5e..e5489d1537 100644
+--- a/libavcodec/nvdec.c
++++ b/libavcodec/nvdec.c
+@@ -524,6 +524,10 @@ static int nvdec_retrieve_data(void *logctx, AVFrame *frame)
+     if (ret < 0)
+         goto finish;
+ 
++    ret = av_buffer_replace(&frame->hw_frames_ctx, decoder->real_hw_frames_ref);
++    if (ret < 0)
++        goto copy_fail;
++
+     unmap_data = av_mallocz(sizeof(*unmap_data));
+     if (!unmap_data) {
+         ret = AVERROR(ENOMEM);
+@@ -538,10 +542,6 @@ static int nvdec_retrieve_data(void *logctx, AVFrame *frame)
+         goto copy_fail;
+     }
+ 
+-    ret = av_buffer_replace(&frame->hw_frames_ctx, decoder->real_hw_frames_ref);
+-    if (ret < 0)
+-        goto copy_fail;
+-
+     unmap_data->idx = cf->idx;
+     unmap_data->idx_ref = av_refstruct_ref(cf->idx_ref);
+     unmap_data->decoder = av_refstruct_ref(cf->decoder);
+@@ -556,12 +556,8 @@ static int nvdec_retrieve_data(void *logctx, AVFrame *frame)
+     goto finish;
+ 
+ copy_fail:
+-    if (!frame->buf[1]) {
+-        CHECK_CU(decoder->cvdl->cuvidUnmapVideoFrame(decoder->decoder, devptr));
+-        av_freep(&unmap_data);
+-    } else {
+-        av_buffer_unref(&frame->buf[1]);
+-    }
++    CHECK_CU(decoder->cvdl->cuvidUnmapVideoFrame(decoder->decoder, devptr));
++    av_freep(&unmap_data);
+ 
+ finish:
+     CHECK_CU(decoder->cudl->cuCtxPopCurrent(&dummy));

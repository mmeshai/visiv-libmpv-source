+--- a/demux/demux_mkv.c
++++ b/demux/demux_mkv.c
+@@ -368,6 +368,10 @@ static bstr demux_mkv_decode(struct mp_log *log, mkv_track_t *track,
+ 
+             size = zstream.total_out;
+             inflateEnd(&zstream);
++            // The output can be the input of a following LZO encoding, so zero

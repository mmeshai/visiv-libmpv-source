diff --git a/packages/ffmpeg-0106-avformat-rtsp-Validate-the-SampleRate-SDP-attribute.patch b/packages/ffmpeg-0106-avformat-rtsp-Validate-the-SampleRate-SDP-attribute.patch
new file mode 100644
index 0000000..1c5cfd6
--- /dev/null
+++ b/packages/ffmpeg-0106-avformat-rtsp-Validate-the-SampleRate-SDP-attribute.patch
@@ -0,0 +1,78 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Furkan Efe Can <caglarf646@gmail.com>
+Date: Tue, 13 Oct 2026 00:39:45 +0300
+Subject: [PATCH 106/178] avformat/rtsp: Validate the SampleRate SDP attribute
+
+sdp_parse_line() stored the "SampleRate:integer;" attribute straight into
+codecpar->sample_rate without any check:
+
+    st = s->streams[s->nb_streams - 1];
+    st->codecpar->sample_rate = atoi(p);
+
+The value comes from the SDP description, i.e. from the server, so a
+negative sample rate ends up on the stream. atoi() additionally has
+undefined behaviour when the value does not fit into an int, which is
+why 088f08db71 removed it from matroskaenc.
+
+Measured with a minimal SDP fed to the sdp demuxer, before this patch:
+
+    SampleRate:integer;48000                  -> sample_rate = 48000
+    SampleRate:integer;-1                     -> sample_rate = -1
+    SampleRate:integer;99999999999999999999   -> sample_rate = -1
+
+Every other demuxer rejects such values (4xm.c, adxdec.c, 3dostr.c,
+apac.c, ads.c all test sample_rate <= 0), and rtsp.c itself already
+guards the rtpmap sample rate and channel count with "if (i > 0)" a few
+hundred lines earlier, so only this attribute was left unchecked.
+
+Use strtol() with base 10, check errno for ERANGE, and ignore values
+outside the valid range, keeping whatever rate the rtpmap line
+established.  Base 10 matters: with base 0 a leading zero would select
+octal and silently reinterpret existing decimal rates.  The ERANGE test
+matters where LONG_MAX == INT_MAX, since there a positive overflow
+returns INT_MAX and would otherwise pass the upper bound check.
+
+Measured after the patch, with the rtpmap rate held at 44100:
+
+    SampleRate:integer;48000                  -> 48000 Hz
+    SampleRate:integer;048000                 -> 48000 Hz
+    SampleRate:integer;044100                 -> 44100 Hz
+    SampleRate:integer;-1                     -> rejected, keeps 44100
+    SampleRate:integer;0                      -> rejected, keeps 44100
+    SampleRate:integer;99999999999999999999   -> rejected, keeps 44100
+
+Note this is defence in depth rather than a fix for a reachable crash:
+nothing in the RTP/RDT path divides by sample_rate, and avcodec.c
+rejects a negative rate when the decoder is opened.
+
+Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
+Signed-off-by: Furkan Efe Can <caglarf646@gmail.com>
+(cherry picked from commit a7b20ee103356f2ca5ffcdc6f3c38ae0853e0648)
+---
+ libavformat/rtsp.c | 13 +++++++++++--
+ 1 file changed, 11 insertions(+), 2 deletions(-)
+
+diff --git a/libavformat/rtsp.c b/libavformat/rtsp.c
+index c07eef8cfe..8d477551e0 100644
+--- a/libavformat/rtsp.c
++++ b/libavformat/rtsp.c
+@@ -681,8 +681,17 @@ static void sdp_parse_line(AVFormatContext *s, SDPParseState *s1,
+                 rt->transport = RTSP_TRANSPORT_RDT;
+         } else if (av_strstart(p, "SampleRate:integer;", &p) &&
+                    s->nb_streams > 0) {
+-            st = s->streams[s->nb_streams - 1];
+-            st->codecpar->sample_rate = atoi(p);
++            long sample_rate;
++
++            errno = 0;
++            sample_rate = strtol(p, NULL, 10);
++            if (errno == ERANGE || sample_rate <= 0 || sample_rate > INT_MAX) {
++                av_log(s, AV_LOG_WARNING,
++                       "Invalid SampleRate %ld in SDP, ignoring\n", sample_rate);
++            } else {
++                st = s->streams[s->nb_streams - 1];
++                st->codecpar->sample_rate = sample_rate;
++            }
+         } else if (av_strstart(p, "crypto:", &p) && s->nb_streams > 0) {
+             // RFC 4568
+             rtsp_st = rt->rtsp_streams[rt->nb_rtsp_streams - 1];
diff --git a/packages/ffmpeg-0107-avformat-mov-Check-sample_rate-in-stsd-version-2-aud.patch b/packages/ffmpeg-0107-avformat-mov-Check-sample_rate-in-stsd-version-2-aud.patch
new file mode 100644
index 0000000..982dca6
--- /dev/null
+++ b/packages/ffmpeg-0107-avformat-mov-Check-sample_rate-in-stsd-version-2-aud.patch
@@ -0,0 +1,87 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Furkan Efe Can <caglarf646@gmail.com>
+Date: Tue, 13 Oct 2026 00:39:45 +0300
+Subject: [PATCH 107/178] avformat/mov: Check sample_rate in stsd version 2
+ audio
+
+The QuickTime SoundDescription version 2 layout stores the sample rate as
+a 64 bit float. Converting it to int is undefined behaviour when the value
+does not fit into int, NaN included -- and NaN slips through every
+integer-style range check because all comparisons against it are false.
+
+The sample_rate < 0 check in ff_mov_read_stsd_entries() runs after the
+conversion has already happened, so it cannot prevent this.
+
+Validate the double before converting it, matching soxdec.
+
+Zero is deliberately still accepted: mov_finalize_stsd_codec() substitutes
+sc->time_scale for a zero audio sample rate, and rejecting zero here would
+remove that existing recovery without being needed for the conversion fix.
+Negative, NaN, infinite and out-of-range values are rejected before the
+conversion.
+
+Fixes: mov.c:3031 runtime error: nan is outside the range of
+       representable values of type 'int'
+
+Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
+Signed-off-by: Furkan Efe Can <caglarf646@gmail.com>
+(cherry picked from commit 3be6c2d9438d9198284c96d7f961a8c1d79b7e2c)
+---
+ libavformat/mov.c | 22 ++++++++++++++++++----
+ 1 file changed, 18 insertions(+), 4 deletions(-)
+
+diff --git a/libavformat/mov.c b/libavformat/mov.c
+index 2e5de07b53..f13de8f4f7 100644
+--- a/libavformat/mov.c
++++ b/libavformat/mov.c
+@@ -2774,8 +2774,8 @@ static void mov_parse_stsd_video(MOVContext *c, AVIOContext *pb,
+     }
+ }
+ 
+-static void mov_parse_stsd_audio(MOVContext *c, AVIOContext *pb,
+-                                 AVStream *st, MOVStreamContext *sc)
++static int mov_parse_stsd_audio(MOVContext *c, AVIOContext *pb,
++                                AVStream *st, MOVStreamContext *sc)
+ {
+     int bits_per_sample, flags;
+     uint16_t version = avio_rb16(pb);
+@@ -2814,8 +2814,18 @@ static void mov_parse_stsd_audio(MOVContext *c, AVIOContext *pb,
+             sc->bytes_per_frame = avio_rb32(pb);
+             avio_rb32(pb); /* bytes per sample */
+         } else if (version == 2) {
++            double sample_rate;
++
+             avio_rb32(pb); /* sizeof struct only */
+-            st->codecpar->sample_rate = av_int2double(avio_rb64(pb));
++            sample_rate = av_int2double(avio_rb64(pb));
++
++            if (sample_rate < 0 || sample_rate > INT_MAX ||
++                isnan(sample_rate)) {
++                av_log(c->fc, AV_LOG_ERROR, "Invalid sample rate %g\n",
++                       sample_rate);
++                return AVERROR_INVALIDDATA;
++            }
++            st->codecpar->sample_rate = sample_rate;
+             channel_count = avio_rb32(pb);
+             st->codecpar->ch_layout.order = AV_CHANNEL_ORDER_UNSPEC;
+             st->codecpar->ch_layout.nb_channels = channel_count;
+@@ -2893,6 +2903,8 @@ static void mov_parse_stsd_audio(MOVContext *c, AVIOContext *pb,
+         st->codecpar->bits_per_coded_sample = bits_per_sample;
+         sc->sample_size = (bits_per_sample >> 3) * st->codecpar->ch_layout.nb_channels;
+     }
++
++    return 0;
+ }
+ 
+ static void mov_parse_stsd_subtitle(MOVContext *c, AVIOContext *pb,
+@@ -3158,7 +3170,9 @@ int ff_mov_read_stsd_entries(MOVContext *c, AVIOContext *pb, int entries)
+         if (st->codecpar->codec_type==AVMEDIA_TYPE_VIDEO) {
+             mov_parse_stsd_video(c, pb, st, sc);
+         } else if (st->codecpar->codec_type==AVMEDIA_TYPE_AUDIO) {
+-            mov_parse_stsd_audio(c, pb, st, sc);
++            ret = mov_parse_stsd_audio(c, pb, st, sc);
++            if (ret < 0)
++                return ret;
+             if (st->codecpar->sample_rate < 0) {
+                 av_log(c->fc, AV_LOG_ERROR, "Invalid sample rate %d\n", st->codecpar->sample_rate);
+                 return AVERROR_INVALIDDATA;
diff --git a/packages/ffmpeg-0108-avformat-rtpdec_rfc4175-Do-not-leak-the-frame-finali.patch b/packages/ffmpeg-0108-avformat-rtpdec_rfc4175-Do-not-leak-the-frame-finali.patch
new file mode 100644
index 0000000..23b1f25
--- /dev/null
+++ b/packages/ffmpeg-0108-avformat-rtpdec_rfc4175-Do-not-leak-the-frame-finali.patch
@@ -0,0 +1,134 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Michael Niedermayer <michael@niedermayer.cc>
+Date: Wed, 7 Oct 2026 00:05:08 +0200
+Subject: [PATCH 108/178] avformat/rtpdec_rfc4175: Do not leak the frame
+ finalized on a missed marker
+
+When a packet with a new timestamp put the previous frame into pkt, an
+invalid packet returned an error with the frame still in pkt, and a
+packet with the marker set put the new frame into the same pkt. In both
+cases the previous frame was lost and its buffer leaked, once per such
+packet, so a sender can exhaust the memory of the receiver.
+Return the previous frame in these cases, and the new one from the
+following call.
+
+Fixes: memleak
+Fixes: iF2DzMcFQavi
+Memory leak Replicated through UnModified FFmpeg with ASAN
+Found during triage of the security report V8a3e2cGQI7w
+
+(cherry picked from commit ed314d886012bd52d3ea9705861b8c6743c200c4)
+---
+ libavformat/rtpdec_rfc4175.c | 38 +++++++++++++++++++++++-------------
+ 1 file changed, 24 insertions(+), 14 deletions(-)
+
+diff --git a/libavformat/rtpdec_rfc4175.c b/libavformat/rtpdec_rfc4175.c
+index 41bf4a2c5d..f38f40b7d3 100644
+--- a/libavformat/rtpdec_rfc4175.c
++++ b/libavformat/rtpdec_rfc4175.c
+@@ -238,13 +238,21 @@ static int rfc4175_handle_packet(AVFormatContext *ctx, PayloadContext *data,
+                                  uint16_t seq, int flags)
+ {
+     int length, line, offset, cont, field;
+-    const uint8_t *headers = buf + 2; /* skip extended seqnum */
+-    const uint8_t *payload = buf + 2;
+-    int payload_len = len - 2;
++    const uint8_t *headers, *payload;
++    int payload_len;
+     int missed_last_packet = 0;
+ 
+     uint8_t *dest;
+ 
++    if (!buf) {
++        *timestamp = data->timestamp;
++        return rfc4175_finalize_packet(data, pkt, st->index);
++    }
++
++    headers = buf + 2; /* skip extended seqnum */
++    payload = buf + 2;
++    payload_len = len - 2;
++
+     if (*timestamp != data->timestamp) {
+         if (data->frame && (!data->interlaced || data->field)) {
+             /*
+@@ -255,8 +263,7 @@ static int rfc4175_handle_packet(AVFormatContext *ctx, PayloadContext *data,
+              * previous frame (or pair of fields) anyway by filling the AVPacket.
+              */
+             av_log(ctx, AV_LOG_ERROR, "Missed previous RTP Marker\n");
+-            missed_last_packet = 1;
+-            rfc4175_finalize_packet(data, pkt, st->index);
++            missed_last_packet = rfc4175_finalize_packet(data, pkt, st->index) >= 0;
+         }
+ 
+         if (!data->frame)
+@@ -266,7 +273,7 @@ static int rfc4175_handle_packet(AVFormatContext *ctx, PayloadContext *data,
+ 
+         if (!data->frame) {
+             av_log(ctx, AV_LOG_ERROR, "Out of memory.\n");
+-            return AVERROR(ENOMEM);
++            return missed_last_packet ? 0 : AVERROR(ENOMEM);
+         }
+     }
+ 
+@@ -276,7 +283,7 @@ static int rfc4175_handle_packet(AVFormatContext *ctx, PayloadContext *data,
+      */
+     do {
+         if (payload_len < 6)
+-            return AVERROR_INVALIDDATA;
++            goto invalid;
+ 
+         cont = payload[4] & 0x80;
+         payload += 6;
+@@ -288,7 +295,7 @@ static int rfc4175_handle_packet(AVFormatContext *ctx, PayloadContext *data,
+         int copy_offset;
+ 
+         if (payload_len < data->pgroup)
+-            return AVERROR_INVALIDDATA;
++            goto invalid;
+ 
+         length = (headers[0] << 8) | headers[1];
+         field = (headers[2] & 0x80) >> 7;
+@@ -299,7 +306,7 @@ static int rfc4175_handle_packet(AVFormatContext *ctx, PayloadContext *data,
+         data->field = field;
+ 
+         if (!data->pgroup || length % data->pgroup)
+-            return AVERROR_INVALIDDATA;
++            goto invalid;
+ 
+         if (length > payload_len)
+             length = payload_len;
+@@ -308,12 +315,12 @@ static int rfc4175_handle_packet(AVFormatContext *ctx, PayloadContext *data,
+             line = 2 * line + field;
+ 
+         if (line >= data->height)
+-            return AVERROR_INVALIDDATA;
++            goto invalid;
+ 
+         /* prevent ill-formed packets to write after buffer's end */
+         copy_offset = (line * data->width + offset) * data->pgroup / data->xinc;
+         if (copy_offset + length > data->frame_size || !data->frame)
+-            return AVERROR_INVALIDDATA;
++            goto invalid;
+ 
+         dest = data->frame + copy_offset;
+         memcpy(dest, payload, length);
+@@ -322,13 +329,16 @@ static int rfc4175_handle_packet(AVFormatContext *ctx, PayloadContext *data,
+         payload_len -= length;
+     } while (cont);
+ 
+-    if ((flags & RTP_FLAG_MARKER)) {
++    if (missed_last_packet) {
++        return !!(flags & RTP_FLAG_MARKER);
++    } else if ((flags & RTP_FLAG_MARKER)) {
+         return rfc4175_finalize_packet(data, pkt, st->index);
+-    } else if (missed_last_packet) {
+-        return 0;
+     }
+ 
+     return AVERROR(EAGAIN);
++
++invalid:
++    return missed_last_packet ? 0 : AVERROR_INVALIDDATA;
+ }
+ 
+ const RTPDynamicProtocolHandler ff_rfc4175_rtp_handler = {
diff --git a/packages/ffmpeg-0109-avformat-rdt-Allocate-the-RMStream-of-a-stream-only-.patch b/packages/ffmpeg-0109-avformat-rdt-Allocate-the-RMStream-of-a-stream-only-.patch

+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: "visiv (nnexd GmbH)" <support@visiv.tv>
+Date: Fri, 13 Nov 2026 00:00:00 +0000
+Subject: [PATCH 156/177] avcodec/exif: pass the IFD bounds in
+ avpriv_exif_decode_ifd()
+
+release/8.1 still has avpriv_exif_decode_ifd() (removed in master by
+e930e2e60a), so the backported bounds of c69aff7454, 26bf8651a8 and
+30fff47764 have to be passed there too: the same initial values as in
+av_exif_parse_buffer() (entries and bytes limited by the buffer size).
+No caller in libavcodec/libavformat uses the function; it only has to
+compile.
+
+visiv addition for the backport series (not in FFmpeg).
+---
+ libavcodec/exif.c | 4 +++-
+ 1 file changed, 3 insertions(+), 1 deletion(-)
+
+diff --git a/libavcodec/exif.c b/libavcodec/exif.c
+index d73d82c72b..7af7ec86aa 100644
+--- a/libavcodec/exif.c
++++ b/libavcodec/exif.c
+@@ -1088,8 +1088,10 @@ int avpriv_exif_decode_ifd(void *logctx, const uint8_t *buf, int size,
+     AVExifMetadata ifd = { 0 };
+     GetByteContext gb;
+     int ret;
++    int entries_left[2] = { size / BASE_TAG_SIZE, size / BASE_TAG_SIZE };
++    size_t bytes_left[2] = { size, size };
+     bytestream2_init(&gb, buf, size);
+-    ret = exif_parse_ifd_list(logctx, &gb, le, depth, &ifd, 0);
++    ret = exif_parse_ifd_list(logctx, &gb, le, depth, entries_left, bytes_left, &ifd, 0);
+     if (ret < 0)
+         return ret;
+     ret = av_exif_ifd_to_dict(logctx, &ifd, metadata);

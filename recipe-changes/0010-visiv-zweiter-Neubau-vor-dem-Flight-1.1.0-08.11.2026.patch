diff --git a/packages/ffmpeg-0012-avutil-avstring-fix-infinite-loop-in-av_strirepla.patch b/packages/ffmpeg-0012-avutil-avstring-fix-infinite-loop-in-av_strirepla.patch
new file mode 100755
index 0000000..90dc030
--- /dev/null
+++ b/packages/ffmpeg-0012-avutil-avstring-fix-infinite-loop-in-av_strirepla.patch
@@ -0,0 +1,36 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Joshua Rogers <MegaManSec@users.noreply.github.com>
+Date: Mon, 31 Aug 2026 15:31:50 +0200
+Subject: [PATCH 12/17] avutil/avstring: fix infinite loop in av_strireplace
+ with empty search string
+
+av_stristr() returns the input pointer unchanged for an empty needle,
+so an empty 'from' argument left pstr never advancing and caused
+av_strireplace() to loop forever (and grow the buffer unboundedly if
+'to' was non-empty). Return a duplicate of 'str' when 'from' is empty.
+
+Fixes: Timeout
+Fixes: q8954W25MJoa
+Fixes: AISLE-2026-0100-00001
+Found-by: Joshua Rogers <joshua.rogers@aisle.com>
+Signed-off-by: Michael Niedermayer <michael@niedermayer.cc>
+(cherry picked from commit ed27bfcbbbc0872c0195eaf4dd2c0c93b9f1778e)
+(cherry picked from commit fd2ff6dabf82714b0c61677f7cccf9d026cb019c)
+---
+ libavutil/avstring.c | 3 +++
+ 1 file changed, 3 insertions(+)
+
+diff --git a/libavutil/avstring.c b/libavutil/avstring.c
+index 281c5cdc88..d8c72a7c77 100644
+--- a/libavutil/avstring.c
++++ b/libavutil/avstring.c
+@@ -234,6 +234,9 @@ char *av_strireplace(const char *str, const char *from, const char *to)
+     size_t tolen = strlen(to), fromlen = strlen(from);
+     AVBPrint pbuf;
+ 
++    if (!fromlen)
++        return av_strdup(str);
++
+     av_bprint_init(&pbuf, 1, AV_BPRINT_SIZE_UNLIMITED);
+     while ((pstr2 = av_stristr(pstr, from))) {
+         av_bprint_append_data(&pbuf, pstr, pstr2 - pstr);
diff --git a/packages/ffmpeg-0013-avformat-dashdec-return-EOF-on-exhausted-byte-rang.patch b/packages/ffmpeg-0013-avformat-dashdec-return-EOF-on-exhausted-byte-rang.patch

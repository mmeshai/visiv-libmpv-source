diff --git a/packages/mpv-0001-mp-image-pool-set-D3D11-BindFlags-for-all-hw-frame.patch b/packages/mpv-0001-mp-image-pool-set-D3D11-BindFlags-for-all-hw-frame.patch
new file mode 100644
index 0000000..ec597a2
--- /dev/null
+++ b/packages/mpv-0001-mp-image-pool-set-D3D11-BindFlags-for-all-hw-frame.patch
@@ -0,0 +1,54 @@
+From e72807e7a0d78302e8f30385fc24c13925aca446 Mon Sep 17 00:00:00 2001
+From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
+Date: Thu, 18 Dec 2025 20:50:40 +0100
+Subject: [PATCH] mp_image_pool: set D3D11 BindFlags for all hw frame pools
+
+It's always needed, not only in d3d11vpp.
+---
+ video/filter/vf_d3d11vpp.c |  4 ----
+ video/mp_image_pool.c      | 10 ++++++++++
+ 2 files changed, 10 insertions(+), 4 deletions(-)
+
+diff --git a/video/filter/vf_d3d11vpp.c b/video/filter/vf_d3d11vpp.c
+index 8dba38a47c24e..fbd9eab4453e6 100644
+--- a/video/filter/vf_d3d11vpp.c
++++ b/video/filter/vf_d3d11vpp.c
+@@ -342,10 +342,6 @@ static struct mp_image *alloc_out(struct mp_filter *vf)
+         return NULL;
+     }
+ 
+-    AVHWFramesContext *hw_frame_ctx = (void *)p->hw_pool->data;
+-    AVD3D11VAFramesContext *d3d11va_frames_ctx = hw_frame_ctx->hwctx;
+-    d3d11va_frames_ctx->BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+-
+     AVFrame *av_frame = av_frame_alloc();
+     MP_HANDLE_OOM(av_frame);
+     if (av_hwframe_get_buffer(p->hw_pool, av_frame, 0) < 0) {
+diff --git a/video/mp_image_pool.c b/video/mp_image_pool.c
+index 2ed9fd7395671..0830bcd29dc0f 100644
+--- a/video/mp_image_pool.c
++++ b/video/mp_image_pool.c
+@@ -23,6 +23,9 @@
+ 
+ #include <libavutil/buffer.h>
+ #include <libavutil/hwcontext.h>
++#if HAVE_D3D11
++#include <libavutil/hwcontext_d3d11va.h>
++#endif
+ #if HAVE_VULKAN
+ #include <libavutil/hwcontext_vulkan.h>
+ #endif
+@@ -404,6 +407,13 @@ bool mp_update_av_hw_frames_pool(struct AVBufferRef **hw_frames_ctx,
+         }
+ #endif
+ 
++#if HAVE_D3D11
++        if (format == AV_PIX_FMT_D3D11) {
++            AVD3D11VAFramesContext *d3d11va_frames_ctx = hw_frames->hwctx;
++            d3d11va_frames_ctx->BindFlags |= D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
++        }
++#endif
++
+         if (av_hwframe_ctx_init(*hw_frames_ctx) < 0) {
+             av_buffer_unref(hw_frames_ctx);
+             return false;
diff --git a/packages/mpv-0002-vf-d3d11vpp-rename-ivctc-to-ivtc.patch b/packages/mpv-0002-vf-d3d11vpp-rename-ivctc-to-ivtc.patch
new file mode 100644
index 0000000..e0570ce
--- /dev/null
+++ b/packages/mpv-0002-vf-d3d11vpp-rename-ivctc-to-ivtc.patch
@@ -0,0 +1,48 @@
+From 626f1344c889d2cb6d04a8952ba8571013c21b3e Mon Sep 17 00:00:00 2001
+From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
+Date: Wed, 18 Feb 2026 03:52:51 +0100
+Subject: [PATCH] vf_d3d11vpp: rename `ivctc` to `ivtc`
+
+This was a typo. Although this changes the user option name, this
+filter, especially this option, is so niche that I fix it without a
+deprecation period.
+---
+ DOCS/interface-changes/vf-d3d11vpp-fix-ivctc-typo.txt | 1 +
+ DOCS/man/vf.rst                                       | 2 +-
+ video/filter/vf_d3d11vpp.c                            | 2 +-
+ 3 files changed, 3 insertions(+), 2 deletions(-)
+ create mode 100644 DOCS/interface-changes/vf-d3d11vpp-fix-ivctc-typo.txt
+
+diff --git a/DOCS/interface-changes/vf-d3d11vpp-fix-ivctc-typo.txt b/DOCS/interface-changes/vf-d3d11vpp-fix-ivctc-typo.txt
+new file mode 100644
+index 0000000000000..2fb00dc712153
+--- /dev/null
++++ b/DOCS/interface-changes/vf-d3d11vpp-fix-ivctc-typo.txt
+@@ -0,0 +1 @@
++rename `d3d11vpp=mode=ivctc` to `d3d11vpp=mode=ivtc`
+diff --git a/DOCS/man/vf.rst b/DOCS/man/vf.rst
+index d9d3dfbe596cb..9f46414fd0c08 100644
+--- a/DOCS/man/vf.rst
++++ b/DOCS/man/vf.rst
+@@ -741,7 +741,7 @@ Available mpv-only filters are:
+             NVIDIA RTX Super Resolution.
+     ``interlaced-only=<yes|no>``
+         If ``yes``, only deinterlace frames marked as interlaced (default: no).
+-    ``mode=<blend|bob|adaptive|mocomp|ivctc|none>``
++    ``mode=<blend|bob|adaptive|mocomp|ivtc|none>``
+         Tries to select a video processor with the given processing capability.
+         If a video processor supports multiple capabilities, it is not clear
+         which algorithm is actually selected. ``none`` always falls back. On
+diff --git a/video/filter/vf_d3d11vpp.c b/video/filter/vf_d3d11vpp.c
+index fbd9eab4453e6..334c9a1d49ad7 100644
+--- a/video/filter/vf_d3d11vpp.c
++++ b/video/filter/vf_d3d11vpp.c
+@@ -643,7 +643,7 @@ static const m_option_t vf_opts_fields[] = {
+         {"bob", D3D11_VIDEO_PROCESSOR_PROCESSOR_CAPS_DEINTERLACE_BOB},
+         {"adaptive", D3D11_VIDEO_PROCESSOR_PROCESSOR_CAPS_DEINTERLACE_ADAPTIVE},
+         {"mocomp", D3D11_VIDEO_PROCESSOR_PROCESSOR_CAPS_DEINTERLACE_MOTION_COMPENSATION},
+-        {"ivctc", D3D11_VIDEO_PROCESSOR_PROCESSOR_CAPS_INVERSE_TELECINE},
++        {"ivtc", D3D11_VIDEO_PROCESSOR_PROCESSOR_CAPS_INVERSE_TELECINE},
+         {"none", 0})},
+     {"parity", OPT_CHOICE(field_parity,
+         {"tff", MP_FIELD_PARITY_TFF},
diff --git a/packages/mpv-0003-vf-d3d11vpp-update-mode-selection-logging.patch b/packages/mpv-0003-vf-d3d11vpp-update-mode-selection-logging.patch

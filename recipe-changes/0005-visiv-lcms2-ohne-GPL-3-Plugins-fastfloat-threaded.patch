From 2d56298e552513bccc5c1eb5dd03188c4135cade Mon Sep 17 00:00:00 2001
From: mpvbuild <mpvbuild@localhost>
Date: Wed, 30 Sep 2026 21:44:20 +0200
Subject: [PATCH 5/7] visiv: lcms2 ohne GPL-3-Plugins (fastfloat, threaded)

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 packages/lcms2.cmake | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/packages/lcms2.cmake b/packages/lcms2.cmake
index 3ed38cf..a5a7a08 100644
--- a/packages/lcms2.cmake
+++ b/packages/lcms2.cmake
@@ -1,3 +1,4 @@
+# visiv: fastfloat- und threaded-Plugins sind GPL-3.0 -> aus (lcms2.pc wuerde sie sonst mitlinken)
 ExternalProject_Add(lcms2
     DEPENDS
         libjpeg
@@ -12,8 +13,8 @@ ExternalProject_Add(lcms2
         --cross-file=${MESON_CROSS}
         --buildtype=release
         --default-library=static
-        -Dfastfloat=true
-        -Dthreaded=true
+        -Dfastfloat=false
+        -Dthreaded=false
     BUILD_COMMAND ${EXEC} ninja -C <BINARY_DIR>
     INSTALL_COMMAND ${EXEC} ninja -C <BINARY_DIR> install
     LOG_DOWNLOAD 1 LOG_UPDATE 1 LOG_CONFIGURE 1 LOG_BUILD 1 LOG_INSTALL 1
-- 

diff --git a/packages/ffmpeg-0011-avformat-hls-catch-up-an-enabled-subtitle-playlist-fr.patch b/packages/ffmpeg-0011-avformat-hls-catch-up-an-enabled-subtitle-playlist-fr.patch
new file mode 100644
index 0000000..d96f1dd
--- /dev/null
+++ b/packages/ffmpeg-0011-avformat-hls-catch-up-an-enabled-subtitle-playlist-fr.patch
@@ -0,0 +1,79 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: "visiv (nnexd GmbH)" <support@visiv.tv>
+Date: Sat, 7 Nov 2026 00:00:00 +0000
+Subject: [PATCH] avformat/hls: catch up an enabled subtitle playlist from the
+ presented position
+
+Subtitle playlists are discarded until the caller selects their stream,
+which a player usually does after avformat_find_stream_info() has already
+read ahead, and a player buffers more before presenting it. Catching up
+from the demuxer position then drops the cues still on screen at the
+position the player shows, including the first one of a live stream.
+
+Catch up from up to three target durations before the demuxer position,
+but not before playback started or the last seek target. Cues that ended
+before what the player presents are dropped by the player itself.
+
+visiv addition on top of the backport of master 729de963f906 (not in FFmpeg).
+---
+ libavformat/hls.c | 19 +++++++++++++++++++
+ 1 file changed, 19 insertions(+)
+
+diff --git a/libavformat/hls.c b/libavformat/hls.c
+index d59bea0..698d82f 100644
+--- a/libavformat/hls.c
++++ b/libavformat/hls.c
+@@ -229,6 +229,7 @@ typedef struct HLSContext {
+     int first_packet;
+     int64_t first_timestamp;
+     int64_t cur_timestamp;
++    int64_t restart_timestamp; /* where playback (re)started: first packet or seek target */
+     AVIOInterruptCB *interrupt_callback;
+     AVDictionary *avio_opts;
+     AVDictionary *seg_format_opts;
+@@ -2328,6 +2329,7 @@ static int hls_read_header(AVFormatContext *s)
+     c->first_packet = 1;
+     c->first_timestamp = AV_NOPTS_VALUE;
+     c->cur_timestamp = AV_NOPTS_VALUE;
++    c->restart_timestamp = AV_NOPTS_VALUE;
+ 
+     if ((ret = ffio_copy_url_options(s->pb, &c->avio_opts)) < 0)
+         return ret;
+@@ -2640,6 +2642,19 @@ static int recheck_discard_flags(AVFormatContext *s, int first)
+             if (c->cur_timestamp != AV_NOPTS_VALUE) {
+                 /* catch up */
+                 pls->seek_timestamp = c->cur_timestamp;
++                /* The player is still presenting what it buffered before the
++                 * demuxer position (at the start, everything the probing read).
++                 * Keep the cues still shown there: catch up from up to three
++                 * target durations back, but not before playback (re)started. */
++                if (pls->is_subtitle) {
++                    pls->seek_timestamp = av_sat_sub64(pls->seek_timestamp,
++                                                       3 * pls->target_duration);
++                    if (c->restart_timestamp != AV_NOPTS_VALUE)
++                        pls->seek_timestamp = FFMAX(pls->seek_timestamp,
++                                                    c->restart_timestamp);
++                    pls->seek_timestamp = FFMIN(pls->seek_timestamp,
++                                                c->cur_timestamp);
++                }
+                 pls->seek_flags = AVSEEK_FLAG_ANY;
+                 pls->seek_stream_index = -1;
+             }
+@@ -2747,6 +2762,9 @@ retry:
+                         pls->pkt->dts       != AV_NOPTS_VALUE)
+                         c->first_timestamp = av_rescale_q(pls->pkt->dts,
+                             get_timebase(pls), AV_TIME_BASE_Q);
++                    if (c->restart_timestamp == AV_NOPTS_VALUE &&
++                        c->first_timestamp   != AV_NOPTS_VALUE)
++                        c->restart_timestamp = c->first_timestamp;
+                 }
+ 
+                 seg = current_segment(pls);
+@@ -2976,6 +2994,7 @@ static int hls_read_seek(AVFormatContext *s, int stream_index,
+     }
+ 
+     c->cur_timestamp = seek_timestamp;
++    c->restart_timestamp = seek_timestamp;
+ 
+     return 0;
+ }

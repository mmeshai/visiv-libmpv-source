+        --enable-demuxer=rtsp
+        --enable-demuxer=sdp
+        --enable-demuxer=rtp
+        --enable-demuxer=aac
+        --enable-demuxer=loas
+        --enable-demuxer=ac3
+        --enable-demuxer=eac3
+        --enable-demuxer=mp3
+        --enable-demuxer=wav
+        --enable-demuxer=ogg
+        --enable-demuxer=flac
+        --enable-demuxer=h264
+        --enable-demuxer=hevc
+        --enable-demuxer=srt
+        --enable-demuxer=ass
+        --enable-demuxer=webvtt
+        --disable-protocols
+        --enable-protocol=file

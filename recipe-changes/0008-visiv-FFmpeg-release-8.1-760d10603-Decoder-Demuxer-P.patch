From 4b189393ca012c15ee5aa0938baecfe5ef52c1e0 Mon Sep 17 00:00:00 2001
From: mpvbuild <mpvbuild@localhost>
Date: Mon, 2 Nov 2026 00:00:00 +0000
Subject: [PATCH 08/14] visiv: FFmpeg release/8.1 (760d10603),
 Decoder/Demuxer/Protokolle nur nach Positivliste (Entscheid 13A)

---
 packages/ffmpeg.cmake | 112 ++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 108 insertions(+), 4 deletions(-)

diff --git a/packages/ffmpeg.cmake b/packages/ffmpeg.cmake
index ede8b5c..6533f74 100644
--- a/packages/ffmpeg.cmake
+++ b/packages/ffmpeg.cmake
@@ -1,9 +1,9 @@
 # visiv LGPL build: FFmpeg ohne GPL/nonfree-Komponenten.
 # Grundlage: shinchiro/mpv-winbuild-cmake, LGPL-Schalter nach media-kit/libmpv-win32-video-build.
-# Unterschiede zu media-kit (2023/2024): alle LGPL-Decoder/Demuxer/Parser/Filter/Protokolle an
-# (statt kuratierter Liste), Encoder nur png/mjpeg (Screenshots), Muxer nur spdif (Passthrough)
+# Seit 02.11.2026: Decoder, Demuxer und Protokolle nur nach Positivliste (vorher alle LGPL-Teile);
+# Parser/Filter/BSF weiter alle LGPL-Teile, Encoder nur png/mjpeg (Screenshots), Muxer nur spdif (Passthrough)
 # + mpegts/matroska/mp4/mov (mpv stream-record/dump-cache), TLS ueber OpenSSL 3 (Apache-2.0).
-# Stand: Branch release/8.1 (29e619e767, = n8.1.3 + 9 Korrekturen vom 26.-29.09.2026)
+# Stand: Branch release/8.1 (760d10603, = n8.1.3 + 32 Korrekturen bis 01.11.2026)
 # + ffmpeg-00*.patch: HTTP-Seek-Korrekturen aus master (Juni/Sept. 2026), ohne die schlaegt in n8.1.x
 #   das Zurueckspulen auf vielen HTTP(S)-Servern fehl (Soft-Seek-Unterlauf, Verbindung trotz close wiederverwendet).
 ExternalProject_Add(ffmpeg
@@ -18,7 +18,7 @@ ExternalProject_Add(ffmpeg
         libvpl
     GIT_REPOSITORY https://github.com/FFmpeg/FFmpeg.git
     SOURCE_DIR ${SOURCE_LOCATION}
-    GIT_TAG 29e619e767cde9045a75c29bc9a8278ae7b3a98b
+    GIT_TAG 760d10603ecd7ea1e47a5787b2c7d47d5bc257f2
     GIT_CLONE_FLAGS "--sparse --filter=tree:0"
     GIT_CLONE_POST_COMMAND "sparse-checkout set --no-cone /* !tests/ref/fate"
     UPDATE_COMMAND ""
@@ -52,6 +52,110 @@ ExternalProject_Add(ffmpeg
         --enable-muxer=mp4
         --enable-muxer=mov
         --enable-network
+        # visiv 02.11.2026 (Entscheid 13A, Bericht FFmpeg-CVE-Pruefung): nur was IPTV braucht.
+        # Begruendung je Eintrag: visiv third_party/libmpv/DECODER-LISTE.md (gemeinsame Vorgabe Windows/Android).
+        --disable-decoders
+        --enable-decoder=h264
+        --enable-decoder=hevc
+        --enable-decoder=mpeg2video
+        --enable-decoder=mpeg1video
+        --enable-decoder=mpeg4
+        --enable-decoder=msmpeg4v1
+        --enable-decoder=msmpeg4v2
+        --enable-decoder=msmpeg4v3
+        --enable-decoder=vc1
+        --enable-decoder=wmv1
+        --enable-decoder=wmv2
+        --enable-decoder=wmv3
+        --enable-decoder=vp8
+        --enable-decoder=vp9
+        --enable-decoder=av1
+        --enable-decoder=libdav1d
+        --enable-decoder=aac
+        --enable-decoder=aac_latm
+        --enable-decoder=ac3
+        --enable-decoder=eac3
+        --enable-decoder=dca
+        --enable-decoder=truehd
+        --enable-decoder=mlp
+        --enable-decoder=mp1
+        --enable-decoder=mp1float
+        --enable-decoder=mp2
+        --enable-decoder=mp2float
+        --enable-decoder=mp3
+        --enable-decoder=mp3float
+        --enable-decoder=opus
+        --enable-decoder=vorbis
+        --enable-decoder=flac
+        --enable-decoder=alac
+        --enable-decoder=s302m
+        --enable-decoder=wmav1
+        --enable-decoder=wmav2
+        --enable-decoder=wmapro
+        --enable-decoder=pcm_s16le
+        --enable-decoder=pcm_s16be
+        --enable-decoder=pcm_s24le
+        --enable-decoder=pcm_s24be
+        --enable-decoder=pcm_s32le
+        --enable-decoder=pcm_s32be
+        --enable-decoder=pcm_f32le
+        --enable-decoder=pcm_f64le
+        --enable-decoder=pcm_u8
+        --enable-decoder=pcm_alaw
+        --enable-decoder=pcm_mulaw
+        --enable-decoder=pcm_bluray
+        --enable-decoder=pcm_dvd
+        --enable-decoder=ass
+        --enable-decoder=ssa
+        --enable-decoder=srt
+        --enable-decoder=subrip
+        --enable-decoder=webvtt
+        --enable-decoder=movtext
+        --enable-decoder=dvbsub
+        --enable-decoder=dvdsub
+        --enable-decoder=pgssub
+        --enable-decoder=ccaption
+        --enable-decoder=png
+        --enable-decoder=mjpeg
+        --disable-demuxers
+        --enable-demuxer=mpegts
+        --enable-demuxer=hls
+        --enable-demuxer=dash
+        --enable-demuxer=mov
+        --enable-demuxer=matroska
+        --enable-demuxer=flv
+        --enable-demuxer=live_flv
+        --enable-demuxer=avi
+        --enable-demuxer=mpegps
+        --enable-demuxer=mpegvideo
